# Copy to tests/live/.env (gitignored). chmod 0600 the token file.
# Create a *temporary* Cloudflare API token: Zone → DNS → Edit, bound to crms.hk.
# Revoke that token in the dashboard after teardown.

CF_LIVE=1
CF_LIVE_DOMAIN=crms.hk
CF_LIVE_SUBDOMAIN=dns-cli-tmp
# Absolute path, mode 0600, one line, no JSON
CF_LIVE_TOKEN_FILE=
CF_LIVE_ZONE_ID=
CF_LIVE_ACCOUNT_ID=
CF_LIVE_USER_ID=
# Optional; default is <repo>/.live-vault (gitignored, not /tmp)
# CF_LIVE_VAULT_DIR=
