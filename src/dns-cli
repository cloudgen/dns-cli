cf_vault_path_forbidden() {
    _p="$1"
    case "${_p}" in
        /tmp|/tmp/*|/dev/shm|/dev/shm/*)
            return 0
            ;;
    esac
    return 1
}

# Specified vault wins: --vault-dir then CF_VAULT_DIR. Empty = use default.
cf_vault_specified_root() {
    if [ -n "${CF_OPT_VAULT_DIR:-}" ]; then
        printf '%s' "${CF_OPT_VAULT_DIR}"
        return 0
    fi
    if [ -n "${CF_VAULT_DIR:-}" ]; then
        printf '%s' "${CF_VAULT_DIR}"
        return 0
    fi
    return 1
}

cf_vault_dir_probe() {
    : "${APP_NAME:=dns-cli}"
    if _spec=$(cf_vault_specified_root); then
        case "${_spec}" in
            /*) ;;
            *)
                printf '%s' ""
                return 1
                ;;
        esac
        if cf_vault_path_forbidden "${_spec}"; then
            printf '%s' ""
            return 1
        fi
        printf '%s' "${_spec}"
        return 0
    fi
    if ! lpu_account_present; then
        printf '%s' ""
        return 1
    fi
    _vd=$(lpu_default_vault_dir) || {
        printf '%s' ""
        return 1
    }
    if cf_vault_path_forbidden "${_vd}"; then
        printf '%s' ""
        return 1
    fi
    printf '%s' "${_vd}"
    return 0
}

# ALIGNMENT: requirement-application-local-vault.md (AV-M*)
# Specify wins; else LPU-home .local/vaults/${APP_NAME}; else lpu_missing.
cf_vault_dir() {
    : "${APP_NAME:=dns-cli}"
    if _spec=$(cf_vault_specified_root); then
        case "${_spec}" in
            /*) ;;
            *)
                out_die_code vault_insecure "Vault dir must be an absolute path"
                ;;
        esac
        if cf_vault_path_forbidden "${_spec}"; then
            out_die_code vault_insecure "Specified vault path is under /tmp or /dev/shm: ${_spec}"
        fi
        CFV_DIR="${_spec}"
        return 0
    fi
    if ! lpu_account_present; then
        out_die_code lpu_missing "dns-adm is not on this host. Next: sudo ${APP_NAME} setup  (or --vault-dir for QA)"
    fi
    _vd=$(lpu_default_vault_dir) || out_die_code vault_no_home "dns-adm exists but home is empty; refusing vault I/O"
    if cf_vault_path_forbidden "${_vd}"; then
        out_die_code vault_insecure "LPU vault path is under /tmp or /dev/shm: ${_vd}"
    fi
    if ! lpu_invoker_is_lpu; then
        lpu_type2_die_required
    fi
    CFV_DIR="${_vd}"
}

cf_hex32_ok() {
    printf '%s' "$1" | grep -Eq '^[0-9a-f]{32}$'
}

cf_apex_ok() {
    printf '%s' "$1" | grep -Eq '^[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?$'
}

cf_label_ok() {
    if [ "$1" = "@" ]; then
        return 0
    fi
    # Token-probe labels only (not stored as vault subdomains).
    if printf '%s' "$1" | grep -Eq '^_test_[0-9]{8,14}$'; then
        return 0
    fi
    printf '%s' "$1" | grep -Eq '^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$'
}

cf_norm_apex() {
    _n=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
    _n="${_n%.}"
    printf '%s' "${_n}"
}

cf_norm_label() {
    _n=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
    _n="${_n%.}"
    _apex=$(cf_norm_apex "${2:-}")
    if [ -n "${_apex}" ] && [ "${_n}" = "${_apex}" ]; then
        printf '%s' "@"
        return 0
    fi
    if [ -n "${_apex}" ]; then
        case "${_n}" in
            *.${_apex})
                _n="${_n%.${_apex}}"
                ;;
        esac
    fi
    printf '%s' "${_n}"
}

cf_derive_fqdn() {
    _lab="$1"
    _apex="$2"
    if [ "${_lab}" = "@" ]; then
        printf '%s' "${_apex}"
    else
        printf '%s' "${_lab}.${_apex}"
    fi
}

cf_ipv4_ok() {
    _ip="$1"
    printf '%s' "${_ip}" | grep -Eq '^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$' || return 1
    _a=$(printf '%s' "${_ip}" | cut -d. -f1)
    _b=$(printf '%s' "${_ip}" | cut -d. -f2)
    _c=$(printf '%s' "${_ip}" | cut -d. -f3)
    _d=$(printf '%s' "${_ip}" | cut -d. -f4)
    for _o in "${_a}" "${_b}" "${_c}" "${_d}"; do
        if [ "${_o}" -lt 0 ] 2>/dev/null || [ "${_o}" -gt 255 ] 2>/dev/null; then
            return 1
        fi
    done
    if [ "${_ip}" = "0.0.0.0" ] || [ "${_ip}" = "255.255.255.255" ]; then
        return 1
    fi
    if [ "${_a}" -eq 127 ]; then
        return 1
    fi
    if [ "${_a}" -eq 169 ] && [ "${_b}" -eq 254 ]; then
        return 1
    fi
    if [ "${_a}" -ge 224 ] && [ "${_a}" -le 239 ]; then
        return 1
    fi
    return 0
}

cf_mode_ok_0600() {
    _f="$1"
    [ -f "${_f}" ] || return 1
    _m=$(stat -c '%a' "${_f}" 2>/dev/null || stat -f '%OLp' "${_f}" 2>/dev/null || echo "")
    [ "${_m}" = "600" ]
}

cf_mode_ok_0700() {
    _d="$1"
    [ -d "${_d}" ] || return 1
    _m=$(stat -c '%a' "${_d}" 2>/dev/null || stat -f '%OLp' "${_d}" 2>/dev/null || echo "")
    [ "${_m}" = "700" ]
}

cf_vault_ensure_dir0700() {
    _vd="$1"
    umask 077
    if [ ! -d "${_vd}" ]; then
        mkdir -p "${_vd}" || out_die_code vault_insecure "Cannot create vault dir"
        chmod 0700 "${_vd}" || out_die_code vault_insecure "Cannot chmod vault dir"
    fi
    if ! cf_mode_ok_0700 "${_vd}"; then
        chmod 0700 "${_vd}" || out_die_code vault_insecure "Vault dir is not 0700"
        if ! cf_mode_ok_0700 "${_vd}"; then
            out_die_code vault_insecure "Vault dir is not 0700"
        fi
    fi
}

cf_vault_atomic_write() {
    _dest="$1"
    _data="$2"
    cf_vault_dir
    _parent=$(dirname "${_dest}")
    cf_vault_ensure_dir0700 "${_parent}"
    umask 077
    _tmp=$(mktemp "${_parent}/.tmp.XXXXXX") || out_die_code vault_insecure "mktemp failed in vault dir"
    chmod 0600 "${_tmp}" || out_die_code vault_insecure "chmod 0600 failed"
    printf '%s' "${_data}" >"${_tmp}" || out_die_code vault_insecure "vault write failed"
    mv -f "${_tmp}" "${_dest}" || out_die_code vault_insecure "vault replace failed"
}

cf_dns_mode_canon() {
    case "$1" in
        non-round-robin|non_round_robin|non-rr|norr|single)
            printf '%s' "non-round-robin"
            ;;
        round-robin|round_robin|rr|multi)
            printf '%s' "round-robin"
            ;;
        *)
            return 1
            ;;
    esac
}

cf_json_have_tool() {
    if command -v python3 >/dev/null 2>&1; then
        return 0
    fi
    if command -v jq >/dev/null 2>&1; then
        return 0
    fi
    return 1
}

cf_json_get() {
    _jf="$1"
    _jp="$2"
    if command -v python3 >/dev/null 2>&1; then
        python3 -c '
import json, sys
path = sys.argv[1]
with open(sys.argv[2], encoding="utf-8") as fh:
    cur = json.load(fh)
for p in path.split("."):
    if p == "length" and isinstance(cur, list):
        print(len(cur))
        raise SystemExit(0)
    if isinstance(cur, dict):
        cur = cur.get(p)
    else:
        raise SystemExit(2)
if cur is None:
    raise SystemExit(2)
if isinstance(cur, bool):
    print("true" if cur else "false")
elif isinstance(cur, (dict, list)):
    json.dump(cur, sys.stdout)
    print()
else:
    print(cur)
' "${_jp}" "${_jf}"
        return $?
    fi
    if command -v jq >/dev/null 2>&1; then
        case "${_jp}" in
            *.length)
                _jp2="${_jp%.length}"
                jq -r ".${_jp2} | length" "${_jf}"
                ;;
            *)
                jq -r ".${_jp}" "${_jf}"
                ;;
        esac
        return $?
    fi
    out_die_code json_tool_missing "Need python3 or jq to parse JSON"
}

# Append one host-label. Command substitution strips trailing newlines, so
# callers must not concatenate "${existing}${new}" when existing may lack a
# terminator (one stored label would become "homeoffice").
cf_labels_append() {
    _ex="$1"
    _nw="$2"
    if [ -z "${_ex}" ]; then
        printf '%s\n' "${_nw}"
        return 0
    fi
    printf '%s\n%s\n' "${_ex}" "${_nw}"
}

cf_vault_index_path() {
    printf '%s' "${CFV_DIR}/index.json"
}

cf_vault_slot_dir() {
    printf '%s' "${CFV_DIR}/accounts/${1}"
}

cf_vault_reject_v1() {
    cf_vault_dir
    if [ -f "${CFV_DIR}/vault.json" ]; then
        out_die_code vault_invalid "v1 vault layout is not supported; use vault account add"
    fi
}

cf_vault_index_empty() {
    printf '%s' '{"schema_version":2,"default_domain_id":null,"domain_ids":[]}'
}

cf_vault_index_write() {
    _idx="$1"
    cf_vault_atomic_write "$(cf_vault_index_path)" "${_idx}"
}

cf_vault_index_load() {
    cf_vault_dir
    cf_vault_reject_v1
    CFV_INDEX_JSON=""
    CFV_DOMAIN_IDS=""
    CFV_DEFAULT_ID=""
    if [ ! -f "$(cf_vault_index_path)" ]; then
        return 1
    fi
    if ! cf_mode_ok_0600 "$(cf_vault_index_path)"; then
        out_die_code vault_insecure "index.json mode is not 0600"
    fi
    _sv=$(cf_json_get "$(cf_vault_index_path)" "schema_version" 2>/dev/null || echo "")
    if [ "${_sv}" != "2" ]; then
        out_die_code vault_invalid "Unknown or missing index schema_version"
    fi
    CFV_DEFAULT_ID=$(cf_json_get "$(cf_vault_index_path)" "default_domain_id" 2>/dev/null || echo "")
    if [ "${CFV_DEFAULT_ID}" = "null" ]; then
        CFV_DEFAULT_ID=""
    fi
    CFV_DOMAIN_IDS=$(cf_json_get "$(cf_vault_index_path)" "domain_ids" 2>/dev/null | python3 -c '
import json,sys
try:
    data=json.load(sys.stdin)
except Exception:
    data=[]
if isinstance(data, list):
    for x in data:
        if isinstance(x, str) and x.strip():
            print(x.strip())
' 2>/dev/null || true)
    return 0
}

cf_vault_index_rebuild() {
    cf_vault_dir
    _ids="$1"
    _def="$2"
    _json=$(printf '%s\n' "${_ids}" | python3 -c '
import json,sys
ids=[ln.strip() for ln in sys.stdin if ln.strip()]
default=sys.argv[1]
if default == "" or default not in ids:
    default = ids[0] if len(ids)==1 else (default if default in ids else None)
    if default == "":
        default = None
obj={"schema_version":2,"default_domain_id":default if default else None,"domain_ids":ids}
print(json.dumps(obj, separators=(",", ":")))
' "${_def}")
    cf_vault_index_write "${_json}"
}

cf_vault_id_count() {
    _n=0
    while IFS= read -r _id || [ -n "${_id}" ]; do
        [ -z "${_id}" ] && continue
        _n=$((_n + 1))
    done <<EOF
${CFV_DOMAIN_IDS}
EOF
    printf '%s' "${_n}"
}

cf_vault_select_id() {
    _want="${CF_OPT_DOMAIN:-}"
    if [ -z "${_want}" ] && [ -n "${CF_OPT_DOMAIN_ID:-}" ]; then
        _want="${CF_OPT_DOMAIN_ID}"
    fi
    if [ -z "${_want}" ] && [ -n "${CF_VAULT_ACCT_ID:-}" ]; then
        _want="${CF_VAULT_ACCT_ID}"
    fi
    if [ -z "${_want}" ] && [ -n "${CF_DOMAIN:-}" ]; then
        _want="${CF_DOMAIN}"
    fi
    if [ -z "${_want}" ] && [ -n "${CF_DOMAIN_ID:-}" ]; then
        _want="${CF_DOMAIN_ID}"
    fi
    if [ -n "${_want}" ]; then
        CFV_SEL_ID=$(cf_norm_apex "${_want}")
        return 0
    fi
    cf_vault_index_load || true
    if [ -n "${CFV_DEFAULT_ID}" ]; then
        CFV_SEL_ID=$(cf_norm_apex "${CFV_DEFAULT_ID}")
        return 0
    fi
    _n=0
    _only=""
    while IFS= read -r _id || [ -n "${_id}" ]; do
        [ -z "${_id}" ] && continue
        _n=$((_n + 1))
        _only="${_id}"
    done <<EOF
${CFV_DOMAIN_IDS}
EOF
    if [ "${_n}" -eq 1 ]; then
        CFV_SEL_ID="${_only}"
        return 0
    fi
    if [ "${_n}" -eq 0 ]; then
        return 1
    fi
    out_die_code domain_required "Pass --domain (vault has ${_n} domain-ids)"
}

cf_vault_slot_encode() {
    if ! cf_json_have_tool; then
        out_die_code json_tool_missing "Need python3 or jq to write vault.json"
    fi
    printf '%s' "${CFV_SUBPAIRS}" | python3 -c '
import json,sys
user, acct, zone, domain = sys.argv[1:5]
pairs=[]
seen=set()
for ln in sys.stdin.read().splitlines():
    ln=ln.strip()
    if not ln:
        continue
    if "|" in ln:
        lab, mode = ln.split("|", 1)
    else:
        raise SystemExit(2)
    if lab in seen:
        raise SystemExit(3)
    seen.add(lab)
    pairs.append({"label": lab, "mode": mode})
if not pairs:
    raise SystemExit(4)
obj={"schema_version":2,"user_id":user,"account_id":acct,"zone_id":zone,"domain":domain,"subdomains":pairs}
json.dump(obj, sys.stdout, separators=(",", ":"))
print()
' "${CFV_USER_ID}" "${CFV_ACCOUNT_ID}" "${CFV_ZONE_ID}" "${CFV_DOMAIN}"
}

cf_vault_write_json() {
    _slot=$(cf_vault_slot_dir "${CFV_DOMAIN}")
    _obj=$(cf_vault_slot_encode) || out_die_code vault_invalid "Cannot encode vault slot"
    cf_vault_atomic_write "${_slot}/vault.json" "${_obj}"
}

cf_vault_load_slot() {
    _sid="$1"
    _slot=$(cf_vault_slot_dir "${_sid}")
    CFV_ZONE_ID=""
    CFV_ACCOUNT_ID=""
    CFV_USER_ID=""
    CFV_DOMAIN=""
    CFV_SUBDOMAINS=""
    CFV_SUBPAIRS=""
    CFV_TOKEN=""
    if [ ! -d "${_slot}" ]; then
        return 1
    fi
    if ! cf_mode_ok_0700 "${_slot}"; then
        out_die_code vault_insecure "Account dir mode is not 0700"
    fi
    if [ ! -f "${_slot}/vault.json" ]; then
        return 1
    fi
    if ! cf_mode_ok_0600 "${_slot}/vault.json"; then
        out_die_code vault_insecure "vault.json mode is not 0600"
    fi
    _sv=$(cf_json_get "${_slot}/vault.json" "schema_version" 2>/dev/null || echo "")
    if [ "${_sv}" != "2" ]; then
        if [ "${2:-strict}" = "soft" ]; then
            return 1
        fi
        out_die_code vault_invalid "Unknown or missing schema_version"
    fi
    CFV_DOMAIN=$(cf_json_get "${_slot}/vault.json" "domain" 2>/dev/null || echo "")
    if [ "${CFV_DOMAIN}" != "${_sid}" ]; then
        out_die_code vault_invalid "domain does not match slot directory"
    fi
    CFV_USER_ID=$(cf_json_get "${_slot}/vault.json" "user_id" 2>/dev/null || echo "")
    CFV_ZONE_ID=$(cf_json_get "${_slot}/vault.json" "zone_id" 2>/dev/null || echo "")
    CFV_ACCOUNT_ID=$(cf_json_get "${_slot}/vault.json" "account_id" 2>/dev/null || echo "")
    _arr=$(cf_json_get "${_slot}/vault.json" "subdomains" 2>/dev/null || echo "[]")
    CFV_SUBPAIRS=$(printf '%s' "${_arr}" | python3 -c '
import json,sys
try:
    data=json.load(sys.stdin)
except Exception:
    raise SystemExit(2)
if not isinstance(data, list):
    raise SystemExit(2)
for x in data:
    if isinstance(x, str):
        raise SystemExit(3)
    if not isinstance(x, dict):
        raise SystemExit(2)
    lab=x.get("label")
    mode=x.get("mode")
    if not lab or not mode:
        raise SystemExit(2)
    print("%s|%s" % (lab, mode))
' 2>/dev/null)
    _pr=$?
    if [ "${_pr}" -eq 3 ]; then
        out_die_code vault_invalid "subdomains must be objects with label and mode"
    fi
    if [ "${_pr}" -ne 0 ]; then
        out_die_code vault_invalid "Invalid subdomains array"
    fi
    CFV_SUBDOMAINS=$(printf '%s\n' "${CFV_SUBPAIRS}" | while IFS= read -r _ln || [ -n "${_ln}" ]; do
        [ -z "${_ln}" ] && continue
        printf '%s\n' "${_ln%%|*}"
    done)
    if [ -f "${_slot}/token" ]; then
        if ! cf_mode_ok_0600 "${_slot}/token"; then
            out_die_code vault_insecure "token file mode is not 0600"
        fi
        CFV_TOKEN=$(tr -d '\n\r' <"${_slot}/token")
    fi
    return 0
}

cf_vault_load() {
    CFV_ZONE_ID=""
    CFV_ACCOUNT_ID=""
    CFV_USER_ID=""
    CFV_DOMAIN=""
    CFV_SUBDOMAINS=""
    CFV_SUBPAIRS=""
    CFV_TOKEN=""
    cf_vault_dir
    if [ ! -d "${CFV_DIR}" ]; then
        return 1
    fi
    if ! cf_mode_ok_0700 "${CFV_DIR}"; then
        out_die_code vault_insecure "Vault dir mode is not 0700"
    fi
    cf_vault_reject_v1
    cf_vault_index_load || return 1
    if ! cf_vault_select_id; then
        return 1
    fi
    cf_vault_load_slot "${CFV_SEL_ID}" || return 1
    return 0
}

cf_vault_read_token_file() {
    _tf="$1"
    if [ ! -f "${_tf}" ]; then
        out_die_code vault_insecure "--token-file is not a regular file"
    fi
    if ! cf_mode_ok_0600 "${_tf}"; then
        out_die_code vault_insecure "--token-file must be mode 0600"
    fi
    tr -d '\n\r' <"${_tf}"
}

cf_vault_merge_missing() {
    if [ -z "${CFV_ZONE_ID}" ] && [ -n "${CF_OPT_ZONE_ID:-}" ]; then
        CFV_ZONE_ID="${CF_OPT_ZONE_ID}"
    fi
    if [ -z "${CFV_ZONE_ID}" ] && [ -n "${CF_ZONE_ID:-}" ]; then
        CFV_ZONE_ID="${CF_ZONE_ID}"
    fi
    if [ -z "${CFV_ACCOUNT_ID}" ] && [ -n "${CF_OPT_ACCOUNT_ID:-}" ]; then
        CFV_ACCOUNT_ID="${CF_OPT_ACCOUNT_ID}"
    fi
    if [ -z "${CFV_ACCOUNT_ID}" ] && [ -n "${CF_ACCOUNT_ID:-}" ]; then
        CFV_ACCOUNT_ID="${CF_ACCOUNT_ID}"
    fi
    if [ -z "${CFV_USER_ID}" ] && [ -n "${CF_OPT_USER_ID:-}" ]; then
        CFV_USER_ID="${CF_OPT_USER_ID}"
    fi
    if [ -z "${CFV_USER_ID}" ] && [ -n "${CF_USER_ID:-}" ]; then
        CFV_USER_ID="${CF_USER_ID}"
    fi
    if [ -z "${CFV_DOMAIN}" ] && [ -n "${CF_OPT_DOMAIN:-}" ]; then
        CFV_DOMAIN=$(cf_norm_apex "${CF_OPT_DOMAIN}")
    fi
    if [ -z "${CFV_DOMAIN}" ] && [ -n "${CF_OPT_DOMAIN_ID:-}" ]; then
        CFV_DOMAIN=$(cf_norm_apex "${CF_OPT_DOMAIN_ID}")
    fi
    if [ -z "${CFV_DOMAIN}" ] && [ -n "${CF_VAULT_ACCT_ID:-}" ]; then
        CFV_DOMAIN=$(cf_norm_apex "${CF_VAULT_ACCT_ID}")
    fi
    if [ -z "${CFV_DOMAIN}" ] && [ -n "${CF_DOMAIN:-}" ]; then
        CFV_DOMAIN=$(cf_norm_apex "${CF_DOMAIN}")
    fi
    if [ -z "${CFV_DOMAIN}" ] && [ -n "${CF_DOMAIN_ID:-}" ]; then
        CFV_DOMAIN=$(cf_norm_apex "${CF_DOMAIN_ID}")
    fi
    if [ -n "${CF_OPT_TOKEN_FILE:-}" ]; then
        if [ -z "${CFV_TOKEN}" ]; then
            CFV_TOKEN=$(cf_vault_read_token_file "${CF_OPT_TOKEN_FILE}")
        fi
    fi
    if [ -z "${CFV_TOKEN}" ] && [ -n "${CF_API_TOKEN:-}" ]; then
        CFV_TOKEN="${CF_API_TOKEN}"
    fi
    if [ -z "${CFV_SUBPAIRS}" ] && [ -n "${CF_OPT_SUBDOMAIN:-}" ]; then
        _nl=$(cf_norm_label "${CF_OPT_SUBDOMAIN}" "${CFV_DOMAIN}")
        _md="non-round-robin"
        if [ -n "${CF_OPT_MODE:-}" ]; then
            _md=$(cf_dns_mode_canon "${CF_OPT_MODE}") || out_die_code vault_invalid "Invalid mode"
        fi
        CFV_SUBPAIRS="${_nl}|${_md}"
        CFV_SUBDOMAINS="${_nl}"
    fi
    if [ -z "${CFV_SUBPAIRS}" ] && [ -n "${CF_SUBDOMAIN:-}" ]; then
        _nl=$(cf_norm_label "${CF_SUBDOMAIN}" "${CFV_DOMAIN}")
        CFV_SUBPAIRS="${_nl}|non-round-robin"
        CFV_SUBDOMAINS="${_nl}"
    fi
}

cf_vault_require_complete() {
    if [ -z "${CFV_TOKEN}" ] || [ -z "${CFV_ZONE_ID}" ] || [ -z "${CFV_ACCOUNT_ID}" ] || [ -z "${CFV_USER_ID}" ] || [ -z "${CFV_DOMAIN}" ] || [ -z "${CFV_SUBPAIRS}" ]; then
        if [ "${JSON}" -eq 1 ] || [ "${QUIET}" -eq 1 ] || [ "${TTY:-0}" -ne 1 ]; then
            out_die_code vault_incomplete "Vault is incomplete (need token, user_id, zone_id, account_id, domain, subdomain)"
        fi
        return 1
    fi
    return 0
}

cf_vault_prompt_missing() {
    if [ -z "${CFV_TOKEN}" ]; then
        CFV_TOKEN=$(prompt_secret "API token")
    fi
    if [ -z "${CFV_USER_ID}" ]; then
        CFV_USER_ID=$(prompt_ask "Cloudflare user-id" "")
    fi
    if [ -z "${CFV_ZONE_ID}" ]; then
        CFV_ZONE_ID=$(prompt_ask "Zone ID" "")
    fi
    if [ -z "${CFV_ACCOUNT_ID}" ]; then
        CFV_ACCOUNT_ID=$(prompt_ask "Account ID" "")
    fi
    if [ -z "${CFV_DOMAIN}" ]; then
        CFV_DOMAIN=$(cf_norm_apex "$(prompt_ask "Apex domain" "")")
    fi
    if [ -z "${CFV_SUBPAIRS}" ]; then
        _nl=$(cf_norm_label "$(prompt_ask "Subdomain host-label (@ for apex)" "")" "${CFV_DOMAIN}")
        CFV_SUBPAIRS="${_nl}|non-round-robin"
        CFV_SUBDOMAINS="${_nl}"
    fi
}

cf_vault_validate_fields() {
    if [ -z "${CFV_TOKEN}" ]; then
        out_die_code vault_incomplete "API token is empty"
    fi
    CFV_ZONE_ID=$(printf '%s' "${CFV_ZONE_ID}" | tr '[:upper:]' '[:lower:]')
    CFV_ACCOUNT_ID=$(printf '%s' "${CFV_ACCOUNT_ID}" | tr '[:upper:]' '[:lower:]')
    CFV_USER_ID=$(printf '%s' "${CFV_USER_ID}" | tr '[:upper:]' '[:lower:]')
    if ! cf_hex32_ok "${CFV_ZONE_ID}"; then
        out_die_code vault_invalid "zone_id must be 32 hex characters"
    fi
    if ! cf_hex32_ok "${CFV_ACCOUNT_ID}"; then
        out_die_code vault_invalid "account_id must be 32 hex characters"
    fi
    if ! cf_hex32_ok "${CFV_USER_ID}"; then
        out_die_code vault_invalid "user_id must be 32 hex characters"
    fi
    CFV_DOMAIN=$(cf_norm_apex "${CFV_DOMAIN}")
    if ! cf_apex_ok "${CFV_DOMAIN}"; then
        out_die_code vault_invalid "domain is not a DNS-safe apex"
    fi
    case "${CFV_DOMAIN}" in
        */*|.*|*..*)
            out_die_code vault_invalid "domain-id is not path-safe"
            ;;
    esac
    _newpairs=""
    _cnt=0
    while IFS= read -r _ln || [ -n "${_ln}" ]; do
        [ -z "${_ln}" ] && continue
        _lab="${_ln%%|*}"
        _md="${_ln#*|}"
        if [ "${_md}" = "${_ln}" ]; then
            _md="non-round-robin"
        fi
        _lab=$(cf_norm_label "${_lab}" "${CFV_DOMAIN}")
        if ! cf_label_ok "${_lab}"; then
            out_die_code vault_invalid "Invalid host-label: ${_lab}"
        fi
        _md=$(cf_dns_mode_canon "${_md}") || out_die_code vault_invalid "Invalid mode: ${_md}"
        _newpairs="${_newpairs}${_lab}|${_md}
"
        _cnt=$((_cnt + 1))
    done <<EOF
${CFV_SUBPAIRS}
EOF
    if [ "${_cnt}" -lt 1 ]; then
        out_die_code vault_incomplete "At least one subdomain host-label is required"
    fi
    CFV_SUBPAIRS="${_newpairs}"
    CFV_SUBDOMAINS=$(printf '%s\n' "${CFV_SUBPAIRS}" | while IFS= read -r _ln || [ -n "${_ln}" ]; do
        [ -z "${_ln}" ] && continue
        printf '%s\n' "${_ln%%|*}"
    done)
}

cf_vault_check_unique() {
    cf_vault_dir
    _self="${CFV_DOMAIN}"
    _acc="${CFV_DIR}/accounts"
    [ -d "${_acc}" ] || return 0
    for _other in "${_acc}"/*; do
        [ -d "${_other}" ] || continue
        _oid=$(basename "${_other}")
        [ "${_oid}" = "${_self}" ] && continue
        [ -f "${_other}/vault.json" ] || continue
        _ou=$(cf_json_get "${_other}/vault.json" "user_id" 2>/dev/null || echo "")
        _oz=$(cf_json_get "${_other}/vault.json" "zone_id" 2>/dev/null || echo "")
        if [ -n "${_ou}" ] && [ "${_ou}" = "${CFV_USER_ID}" ]; then
            out_die_code vault_invalid "user_id already used by another domain-id"
        fi
        if [ -n "${_oz}" ] && [ "${_oz}" = "${CFV_ZONE_ID}" ]; then
            out_die_code vault_invalid "zone_id already used by another domain-id"
        fi
    done
}

cf_vault_persist() {
    cf_vault_validate_fields
    cf_vault_dir
    cf_vault_reject_v1
    cf_vault_check_unique
    _slot=$(cf_vault_slot_dir "${CFV_DOMAIN}")
    cf_vault_ensure_dir0700 "${CFV_DIR}/accounts"
    cf_vault_write_json
    cf_vault_atomic_write "${_slot}/token" "${CFV_TOKEN}"
    cf_vault_index_load || true
    _have=0
    _ids=""
    while IFS= read -r _id || [ -n "${_id}" ]; do
        [ -z "${_id}" ] && continue
        _ids="${_ids}${_id}
"
        if [ "${_id}" = "${CFV_DOMAIN}" ]; then
            _have=1
        fi
    done <<EOF
${CFV_DOMAIN_IDS}
EOF
    if [ "${_have}" -eq 0 ]; then
        _ids="${_ids}${CFV_DOMAIN}
"
    fi
    _def="${CFV_DEFAULT_ID}"
    if [ -z "${_def}" ]; then
        _def="${CFV_DOMAIN}"
    fi
    cf_vault_index_rebuild "${_ids}" "${_def}"
}

cf_vault_apply_set_flags() {
    if [ -n "${CF_OPT_ZONE_ID:-}" ]; then
        CFV_ZONE_ID="${CF_OPT_ZONE_ID}"
    fi
    if [ -n "${CF_OPT_ACCOUNT_ID:-}" ]; then
        CFV_ACCOUNT_ID="${CF_OPT_ACCOUNT_ID}"
    fi
    if [ -n "${CF_OPT_USER_ID:-}" ]; then
        CFV_USER_ID="${CF_OPT_USER_ID}"
    fi
    if [ -n "${CF_OPT_DOMAIN:-}" ]; then
        _nd=$(cf_norm_apex "${CF_OPT_DOMAIN}")
        if [ -n "${CFV_DOMAIN}" ] && [ "${CFV_DOMAIN}" != "${_nd}" ]; then
            out_die_code vault_invalid "domain-id is immutable; remove and add"
        fi
        CFV_DOMAIN="${_nd}"
    fi
    if [ -n "${CF_OPT_DOMAIN_ID:-}" ]; then
        _nd=$(cf_norm_apex "${CF_OPT_DOMAIN_ID}")
        if [ -n "${CFV_DOMAIN}" ] && [ "${CFV_DOMAIN}" != "${_nd}" ]; then
            out_die_code vault_invalid "domain-id is immutable; remove and add"
        fi
        CFV_DOMAIN="${_nd}"
    fi
    if [ -n "${CF_OPT_TOKEN_FILE:-}" ]; then
        CFV_TOKEN=$(cf_vault_read_token_file "${CF_OPT_TOKEN_FILE}")
    fi
    if [ -n "${CF_OPT_SUBDOMAIN:-}" ]; then
        _nl=$(cf_norm_label "${CF_OPT_SUBDOMAIN}" "${CFV_DOMAIN}")
        _md="non-round-robin"
        if [ -n "${CF_OPT_MODE:-}" ]; then
            _md=$(cf_dns_mode_canon "${CF_OPT_MODE}") || out_die_code vault_invalid "Invalid mode"
        fi
        _dup=0
        while IFS= read -r _ln || [ -n "${_ln}" ]; do
            [ -z "${_ln}" ] && continue
            if [ "${_ln%%|*}" = "${_nl}" ]; then
                _dup=1
            fi
        done <<EOF
${CFV_SUBPAIRS}
EOF
        if [ "${_dup}" -eq 0 ]; then
            CFV_SUBPAIRS="${CFV_SUBPAIRS}
${_nl}|${_md}"
        fi
    fi
}

cf_vault_slot_json_fields() {
    _tp="false"
    [ -n "${CFV_TOKEN}" ] && _tp="true"
    _n=0
    while IFS= read -r _ln || [ -n "${_ln}" ]; do
        [ -z "${_ln}" ] && continue
        _n=$((_n + 1))
    done <<EOF
${CFV_SUBPAIRS}
EOF
    _subs=$(printf '%s' "${CFV_SUBPAIRS}" | python3 -c '
import json,sys
out=[]
for ln in sys.stdin.read().splitlines():
    ln=ln.strip()
    if not ln:
        continue
    lab, mode = ln.split("|", 1)
    out.append({"label": lab, "mode": mode})
print(json.dumps(out, separators=(",", ":")))
')
    _def="false"
    if [ "${CFV_DEFAULT_ID}" = "${CFV_DOMAIN}" ]; then
        _def="true"
    fi
    printf '%s' "${_tp}|${_n}|${_subs}|${_def}"
}

cf_vault_emit_slot() {
    _type="$1"
    _msg="$2"
    cf_vault_index_load || true
    _pack=$(cf_vault_slot_json_fields)
    _tp="${_pack%%|*}"
    _rest="${_pack#*|}"
    _n="${_rest%%|*}"
    _rest="${_rest#*|}"
    _subs="${_rest%%|*}"
    _def="${_rest##*|}"
    if [ "${JSON}" -eq 1 ]; then
        out_json "${_type}" "${_msg}" \
            "command" "vault" \
            "vault_dir" "${CFV_DIR}" \
            "domain_id" "${CFV_DOMAIN}" \
            "domain" "${CFV_DOMAIN}" \
            "user_id" "${CFV_USER_ID}" \
            "zone_id" "${CFV_ZONE_ID}" \
            "account_id" "${CFV_ACCOUNT_ID}" \
            "token_present" "${_tp}" \
            "is_default" "${_def}" \
            "subdomain_count" "${_n}" \
            "@subdomains" "${_subs}" \
            "probe_label" "${CF_PROBE_LABEL:-}"
    else
        out_success "${_msg}: ${CFV_DOMAIN}"
        if [ -n "${CF_PROBE_LABEL:-}" ]; then
            out_info "Token probe ${CF_PROBE_LABEL} created and removed"
        fi
    fi
}

cf_vault_cmd_set() {
    cf_vault_dir
    cf_vault_reject_v1
    cf_vault_index_load || true
    if cf_vault_select_id; then
        cf_vault_load_slot "${CFV_SEL_ID}" "soft" || true
    fi
    cf_vault_apply_set_flags
    cf_vault_merge_missing
    if ! cf_vault_require_complete; then
        cf_vault_prompt_missing
    fi
    if [ -n "${CF_OPT_TOKEN_FILE:-}" ]; then
        cf_vault_require_token_probe
    fi
    cf_vault_persist
    if [ "${JSON}" -eq 1 ]; then
        out_json "success" "Vault saved" "command" "vault" "action" "set" \
            "vault_dir" "${CFV_DIR}" "domain_id" "${CFV_DOMAIN}" "token_present" "true"
    else
        out_success "Vault saved under ${CFV_DIR}"
    fi
}

# =============================================================================
# cf_vault_cmd_input() - Interactive wizard (all fields; Enter keeps current)
# =============================================================================
#
# GENERAL PURPOSE:
# Dedicated TTY subcommand to type zone id, account id, apex, subdomain, and
# API token into the vault. Always prompts. Non-TTY / --json fail closed.
#
# ALIGNMENT:
# - requirement-cloudflare-vault.md
# - requirement-shell-interactive-vs-noninteractive.md
#
# Last reviewed: 2026-08-16
# =============================================================================
cf_vault_cmd_input() {
    : "${JSON:=0}"
    : "${QUIET:=0}"
    if [ "${JSON}" -eq 1 ] || [ "${QUIET}" -eq 1 ] || [ "${TTY:-0}" -ne 1 ]; then
        out_die_code confirm_required "vault input requires an interactive TTY; use 'vault set' with flags or --token-file"
    fi
    cf_vault_load || true
    cf_vault_merge_missing
    out_info "Interactive vault input (Enter keeps the current value; token is not echoed)"
    _cur_zone="${CFV_ZONE_ID}"
    _cur_acct="${CFV_ACCOUNT_ID}"
    _cur_user="${CFV_USER_ID}"
    _cur_dom="${CFV_DOMAIN}"
    _cur_lab=""
    while IFS= read -r _lab || [ -n "${_lab}" ]; do
        [ -z "${_lab}" ] && continue
        _cur_lab="${_lab}"
        break
    done <<EOF
${CFV_SUBDOMAINS}
EOF
    CFV_USER_ID=$(prompt_ask "Cloudflare user-id" "${_cur_user}" "${_cur_user}")
    CFV_ZONE_ID=$(prompt_ask "Zone ID" "${_cur_zone}" "${_cur_zone}")
    CFV_ACCOUNT_ID=$(prompt_ask "Account ID" "${_cur_acct}" "${_cur_acct}")
    CFV_DOMAIN=$(cf_norm_apex "$(prompt_ask "Apex domain" "${_cur_dom}" "${_cur_dom}")")
    _new_lab=$(prompt_ask "Subdomain host-label (@ for apex)" "${_cur_lab}" "${_cur_lab}")
    _nl=$(cf_norm_label "${_new_lab}" "${CFV_DOMAIN}")
    CFV_SUBPAIRS="${_nl}|non-round-robin"
    CFV_SUBDOMAINS="${_nl}"
    if [ -n "${CFV_TOKEN}" ]; then
        out_info "Token is already stored (leave blank to keep it)"
    fi
    _tok=$(prompt_secret "API token")
    if [ -n "${_tok}" ]; then
        CFV_TOKEN="${_tok}"
        cf_vault_require_token_probe
    fi
    cf_vault_persist
    out_success "Vault saved under ${CFV_DIR}"
}

cf_vault_cmd_show() {
    cf_vault_load || out_die_code vault_incomplete "Vault is not initialized"
    _slot=$(cf_vault_slot_dir "${CFV_DOMAIN}")
    _vdir="${CFV_DIR}"
    _tp="false"
    [ -n "${CFV_TOKEN}" ] && _tp="true"
    _n=0
    while IFS= read -r _ln || [ -n "${_ln}" ]; do
        [ -z "${_ln}" ] && continue
        _n=$((_n + 1))
    done <<EOF
${CFV_SUBPAIRS}
EOF
    _jm=$(stat -c '%a' "${_slot}/vault.json" 2>/dev/null || echo "")
    _tm=$(stat -c '%a' "${_slot}/token" 2>/dev/null || echo "")
    _dm=$(stat -c '%a' "${_vdir}" 2>/dev/null || echo "")
    _subs=$(printf '%s' "${CFV_SUBPAIRS}" | python3 -c '
import json,sys
out=[]
for ln in sys.stdin.read().splitlines():
    ln=ln.strip()
    if not ln:
        continue
    lab, mode = ln.split("|", 1)
    out.append({"label": lab, "mode": mode})
print(json.dumps(out, separators=(",", ":")))
')
    if [ "${JSON}" -eq 1 ]; then
        out_json "success" "Vault (redacted)" \
            "command" "vault" \
            "vault_dir" "${_vdir}" \
            "token_present" "${_tp}" \
            "user_id" "${CFV_USER_ID}" \
            "zone_id" "${CFV_ZONE_ID}" \
            "account_id" "${CFV_ACCOUNT_ID}" \
            "domain" "${CFV_DOMAIN}" \
            "domain_id" "${CFV_DOMAIN}" \
            "subdomain_count" "${_n}" \
            "dir_mode" "${_dm}" \
            "vault_json_mode" "${_jm}" \
            "token_mode" "${_tm}" \
            "@subdomains" "${_subs}"
    else
        out_info "Vault dir: ${_vdir} (mode ${_dm})"
        out_info "token present: ${_tp} (mode ${_tm})"
        out_info "user_id: ${CFV_USER_ID}"
        out_info "zone_id: ${CFV_ZONE_ID}"
        out_info "account_id: ${CFV_ACCOUNT_ID}"
        out_info "domain: ${CFV_DOMAIN}"
        out_info "subdomains:"
        printf '%s' "${CFV_SUBPAIRS}" | while IFS= read -r _ln || [ -n "${_ln}" ]; do
            [ -z "${_ln}" ] && continue
            out_plain "  ${_ln%%|*} (${_ln#*|})"
        done
    fi
}

cf_vault_cmd_clear() {
    cf_vault_dir
    _vdir="${CFV_DIR}"
    if [ "${JSON}" -eq 1 ] || [ "${QUIET}" -eq 1 ] || [ "${TTY:-0}" -ne 1 ]; then
        if [ "${FORCE}" -ne 1 ]; then
            out_die_code confirm_required "vault clear requires --force in non-interactive mode"
        fi
    else
        if [ "${FORCE}" -ne 1 ]; then
            if ! prompt_yes_no "Delete Cloudflare vault files"; then
                out_die_code confirm_required "vault clear cancelled"
            fi
        fi
    fi
    rm -f "${_vdir}/vault.json" "${_vdir}/token" "${_vdir}/index.json" \
        "${_vdir}/.curl-hdr."* "${_vdir}/.tmp."* 2>/dev/null || true
    if [ -d "${_vdir}/accounts" ]; then
        rm -rf "${_vdir}/accounts"
    fi
    if [ "${JSON}" -eq 1 ]; then
        out_json "success" "Vault cleared" "command" "vault"
    else
        out_success "Vault cleared"
    fi
}

cf_vault_subs_json() {
    printf '%s' "${CFV_SUBPAIRS}" | python3 -c '
import json,sys
out=[]
for ln in sys.stdin.read().splitlines():
    ln=ln.strip()
    if not ln:
        continue
    lab, mode = ln.split("|", 1)
    out.append({"label": lab, "mode": mode})
print(json.dumps(out, separators=(",", ":")))
'
}

cf_vault_label_mode() {
    _want="$1"
    while IFS= read -r _ln || [ -n "${_ln}" ]; do
        [ -z "${_ln}" ] && continue
        if [ "${_ln%%|*}" = "${_want}" ]; then
            printf '%s' "${_ln#*|}"
            return 0
        fi
    done <<EOF
${CFV_SUBPAIRS}
EOF
    return 1
}

cf_vault_live_ipv4_count() {
    _lab="$1"
    if [ -z "${CFV_TOKEN}" ] || [ -z "${CFV_ZONE_ID}" ] || [ -z "${CFV_DOMAIN}" ]; then
        printf '%s' "0"
        return 0
    fi
    _fqdn=$(cf_derive_fqdn "${_lab}" "${CFV_DOMAIN}")
    if ! cf_dns_list "${_fqdn}" 2>/dev/null; then
        printf '%s' "0"
        return 0
    fi
    _n="${CF_DNS_COUNT:-0}"
    rm -f "${CF_DNS_JSON:-}"
    printf '%s' "${_n}"
}

cf_vault_cmd_subdomain() {
    cf_vault_load || out_die_code vault_incomplete "Vault is not initialized"
    _op="${CF_VAULT_SUB_OP:-list}"
    case "${_op}" in
        list)
            _arr=$(cf_vault_subs_json)
            if [ "${JSON}" -eq 1 ]; then
                out_json "success" "Subdomains" "command" "vault" \
                    "domain_id" "${CFV_DOMAIN}" "@subdomains" "${_arr}"
            else
                printf '%s' "${CFV_SUBPAIRS}" | while IFS= read -r _ln || [ -n "${_ln}" ]; do
                    [ -z "${_ln}" ] && continue
                    out_plain "${_ln%%|*} ${_ln#*|}"
                done
            fi
            ;;
        add)
            _nl=$(cf_norm_label "${CF_VAULT_SUB_LABEL:-${CF_OPT_SUBDOMAIN:-}}" "${CFV_DOMAIN}")
            if ! cf_label_ok "${_nl}"; then
                out_die_code vault_invalid "Invalid host-label"
            fi
            _md="non-round-robin"
            if [ -n "${CF_OPT_MODE:-}" ]; then
                _md=$(cf_dns_mode_canon "${CF_OPT_MODE}") || out_die_code vault_invalid "Invalid mode"
            fi
            _dup=0
            while IFS= read -r _ln || [ -n "${_ln}" ]; do
                [ -z "${_ln}" ] && continue
                if [ "${_ln%%|*}" = "${_nl}" ]; then
                    _dup=1
                fi
            done <<EOF
${CFV_SUBPAIRS}
EOF
            if [ "${_dup}" -eq 0 ]; then
                CFV_SUBPAIRS="${CFV_SUBPAIRS}
${_nl}|${_md}"
                cf_vault_persist
            fi
            if [ "${JSON}" -eq 1 ]; then
                out_json "success" "Subdomain present" "command" "vault" \
                    "domain_id" "${CFV_DOMAIN}" "label" "${_nl}" "mode" "${_md}" "subdomain" "${_nl}"
            else
                out_success "Subdomain ${_nl} (${_md})"
            fi
            ;;
        remove)
            _nl=$(cf_norm_label "${CF_VAULT_SUB_LABEL:-${CF_OPT_SUBDOMAIN:-}}" "${CFV_DOMAIN}")
            _keep=""
            _left=0
            _had=0
            _rmode="non-round-robin"
            while IFS= read -r _ln || [ -n "${_ln}" ]; do
                [ -z "${_ln}" ] && continue
                if [ "${_ln%%|*}" = "${_nl}" ]; then
                    _had=1
                    _rmode="${_ln#*|}"
                    continue
                fi
                _keep="${_keep}${_ln}
"
                _left=$((_left + 1))
            done <<EOF
${CFV_SUBPAIRS}
EOF
            if [ "${_left}" -lt 1 ]; then
                out_die_code subdomain_required "Cannot remove the last host-label"
            fi
            CFV_SUBPAIRS="${_keep}"
            cf_vault_persist
            if [ "${JSON}" -eq 1 ]; then
                out_json "success" "Subdomain removed" "command" "vault" \
                    "domain_id" "${CFV_DOMAIN}" "label" "${_nl}" "mode" "${_rmode}" "subdomain" "${_nl}"
            else
                out_success "Removed ${_nl}"
            fi
            ;;
        mode|modify)
            _nl=$(cf_norm_label "${CF_VAULT_SUB_LABEL:-${CF_OPT_SUBDOMAIN:-}}" "${CFV_DOMAIN}")
            _newlab="${CF_OPT_LABEL:-}"
            _newmode="${CF_OPT_MODE:-}"
            if [ "${_op}" = "mode" ]; then
                _newmode="${CF_VAULT_SUB_MODE:-${CF_OPT_MODE:-}}"
            fi
            _found=0
            _curmode=""
            _keep=""
            while IFS= read -r _ln || [ -n "${_ln}" ]; do
                [ -z "${_ln}" ] && continue
                if [ "${_ln%%|*}" = "${_nl}" ]; then
                    _found=1
                    _curmode="${_ln#*|}"
                    continue
                fi
                _keep="${_keep}${_ln}
"
            done <<EOF
${CFV_SUBPAIRS}
EOF
            if [ "${_found}" -eq 0 ]; then
                out_die_code vault_invalid "Unknown host-label: ${_nl}"
            fi
            _outlab="${_nl}"
            _outmode="${_curmode}"
            if [ -n "${_newlab}" ]; then
                _outlab=$(cf_norm_label "${_newlab}" "${CFV_DOMAIN}")
                if ! cf_label_ok "${_outlab}"; then
                    out_die_code vault_invalid "Invalid host-label"
                fi
                while IFS= read -r _ln || [ -n "${_ln}" ]; do
                    [ -z "${_ln}" ] && continue
                    if [ "${_ln%%|*}" = "${_outlab}" ]; then
                        out_die_code vault_invalid "Host-label already exists"
                    fi
                done <<EOF
${_keep}
EOF
            fi
            if [ -n "${_newmode}" ]; then
                _outmode=$(cf_dns_mode_canon "${_newmode}") || out_die_code vault_invalid "Invalid mode"
                if [ "${_outmode}" != "${_curmode}" ]; then
                    _cnt=$(cf_vault_live_ipv4_count "${_nl}")
                    if [ "${_cnt}" -ge 2 ]; then
                        out_die_code dns_mode_locked "Cannot switch mode while ipv4_count=${_cnt}"
                    fi
                fi
            fi
            CFV_SUBPAIRS="${_keep}${_outlab}|${_outmode}
"
            cf_vault_persist
            if [ "${JSON}" -eq 1 ]; then
                out_json "success" "Subdomain modified" "command" "vault" \
                    "domain_id" "${CFV_DOMAIN}" "label" "${_outlab}" "mode" "${_outmode}" "subdomain" "${_outlab}"
            else
                out_success "Subdomain ${_outlab} (${_outmode})"
            fi
            ;;
        *)
            out_die_code vault_invalid "Unknown vault subdomain op"
            ;;
    esac
}

cf_vault_accounts_json() {
    cf_vault_dir
    python3 -c '
import json, os, sys
root = sys.argv[1]
idxp = os.path.join(root, "index.json")
default = None
ids = []
if os.path.isfile(idxp):
    with open(idxp, encoding="utf-8") as fh:
        idx = json.load(fh)
    default = idx.get("default_domain_id")
    ids = list(idx.get("domain_ids") or [])
accs = []
for did in ids:
    slot = os.path.join(root, "accounts", did)
    vj = os.path.join(slot, "vault.json")
    tok = os.path.join(slot, "token")
    if not os.path.isfile(vj):
        continue
    with open(vj, encoding="utf-8") as fh:
        data = json.load(fh)
    subs = data.get("subdomains") or []
    accs.append({
        "domain_id": did,
        "domain": data.get("domain", did),
        "user_id": data.get("user_id", ""),
        "zone_id": data.get("zone_id", ""),
        "account_id": data.get("account_id", ""),
        "token_present": os.path.isfile(tok),
        "is_default": (did == default),
        "subdomain_count": len(subs),
        "subdomains": subs,
    })
obj = {"domain_ids": ids, "default_domain_id": default, "accounts": accs}
json.dump(obj, sys.stdout, separators=(",", ":"))
print()
' "${CFV_DIR}"
}

cf_vault_cmd_account() {
    _op="${CF_VAULT_ACCT_OP:-list}"
    cf_vault_dir
    cf_vault_reject_v1
    case "${_op}" in
        list)
            if [ ! -f "$(cf_vault_index_path)" ]; then
                if [ "${JSON}" -eq 1 ]; then
                    out_json "vault_account_list" "Vault accounts" "command" "vault" \
                        "vault_dir" "${CFV_DIR}" "@domain_ids" "[]" \
                        "default_domain_id" "" "@accounts" "[]"
                else
                    out_info "No vault accounts"
                fi
                return 0
            fi
            _blob=$(cf_vault_accounts_json)
            if [ "${JSON}" -eq 1 ]; then
                _ids=$(printf '%s' "${_blob}" | python3 -c 'import json,sys; print(json.dumps(json.load(sys.stdin).get("domain_ids") or [], separators=(",", ":")))')
                _acc=$(printf '%s' "${_blob}" | python3 -c 'import json,sys; print(json.dumps(json.load(sys.stdin).get("accounts") or [], separators=(",", ":")))')
                _def=$(printf '%s' "${_blob}" | python3 -c 'import json,sys; d=json.load(sys.stdin).get("default_domain_id"); print(d or "")')
                out_json "vault_account_list" "Vault accounts" "command" "vault" \
                    "vault_dir" "${CFV_DIR}" \
                    "default_domain_id" "${_def}" \
                    "@domain_ids" "${_ids}" \
                    "@accounts" "${_acc}"
            else
                printf '%s' "${_blob}" | python3 -c '
import json,sys
data=json.load(sys.stdin)
for a in data.get("accounts") or []:
    mark="*" if a.get("is_default") else " "
    print("%s %s zone=%s user=%s subs=%s" % (mark, a.get("domain_id"), a.get("zone_id"), a.get("user_id"), a.get("subdomain_count")))
'
            fi
            ;;
        add)
            _nid=$(cf_norm_apex "${CF_VAULT_ACCT_ID:-${CF_OPT_DOMAIN:-}}")
            if [ -z "${_nid}" ]; then
                out_die_code domain_required "vault account add requires a domain-id"
            fi
            cf_vault_index_load || true
            while IFS= read -r _id || [ -n "${_id}" ]; do
                [ -z "${_id}" ] && continue
                if [ "${_id}" = "${_nid}" ]; then
                    out_die_code domain_exists "domain-id already present"
                fi
            done <<EOF
${CFV_DOMAIN_IDS}
EOF
            if [ -d "$(cf_vault_slot_dir "${_nid}")" ]; then
                out_die_code domain_exists "domain-id already present"
            fi
            CFV_DOMAIN="${_nid}"
            CFV_ZONE_ID=""
            CFV_ACCOUNT_ID=""
            CFV_USER_ID=""
            CFV_TOKEN=""
            CFV_SUBPAIRS=""
            CFV_SUBDOMAINS=""
            CF_VAULT_ACCT_ID="${_nid}"
            cf_vault_apply_set_flags
            cf_vault_merge_missing
            if ! cf_vault_require_complete; then
                cf_vault_prompt_missing
            fi
            CFV_DOMAIN="${_nid}"
            cf_vault_require_token_probe
            cf_vault_persist
            cf_vault_emit_slot "vault_account_add" "Account added"
            ;;
        modify)
            _nid=$(cf_norm_apex "${CF_VAULT_ACCT_ID:-${CF_OPT_DOMAIN:-}}")
            if [ -z "${_nid}" ]; then
                out_die_code domain_required "vault account modify requires a domain-id"
            fi
            cf_vault_load_slot "${_nid}" || out_die_code vault_incomplete "Unknown domain-id"
            CFV_DOMAIN="${_nid}"
            CF_VAULT_ACCT_ID="${_nid}"
            cf_vault_apply_set_flags
            if [ -n "${CF_OPT_TOKEN_FILE:-}" ]; then
                cf_vault_require_token_probe
            fi
            cf_vault_persist
            cf_vault_emit_slot "vault_account_modify" "Account modified"
            ;;
        remove)
            _nid=$(cf_norm_apex "${CF_VAULT_ACCT_ID:-${CF_OPT_DOMAIN:-}}")
            if [ -z "${_nid}" ]; then
                out_die_code domain_required "vault account remove requires a domain-id"
            fi
            if [ "${JSON}" -eq 1 ] || [ "${QUIET}" -eq 1 ] || [ "${TTY:-0}" -ne 1 ]; then
                if [ "${FORCE}" -ne 1 ]; then
                    out_die_code confirm_required "vault account remove requires --force in non-interactive mode"
                fi
            else
                if [ "${FORCE}" -ne 1 ]; then
                    if ! prompt_yes_no "Remove vault account ${_nid}"; then
                        out_die_code confirm_required "vault account remove cancelled"
                    fi
                fi
            fi
            _slot=$(cf_vault_slot_dir "${_nid}")
            if [ -d "${_slot}" ]; then
                rm -rf "${_slot}"
            fi
            cf_vault_index_load || true
            _ids=""
            while IFS= read -r _id || [ -n "${_id}" ]; do
                [ -z "${_id}" ] && continue
                [ "${_id}" = "${_nid}" ] && continue
                _ids="${_ids}${_id}
"
            done <<EOF
${CFV_DOMAIN_IDS}
EOF
            _def="${CFV_DEFAULT_ID}"
            if [ "${_def}" = "${_nid}" ]; then
                _def=""
            fi
            cf_vault_index_rebuild "${_ids}" "${_def}"
            if [ "${JSON}" -eq 1 ]; then
                out_json "vault_account_remove" "Account removed" "command" "vault" \
                    "domain_id" "${_nid}" "removed" "true"
            else
                out_success "Removed ${_nid}"
            fi
            ;;
        default)
            _nid=$(cf_norm_apex "${CF_VAULT_ACCT_ID:-${CF_OPT_DOMAIN:-}}")
            if [ -z "${_nid}" ]; then
                out_die_code domain_required "vault account default requires a domain-id"
            fi
            cf_vault_index_load || out_die_code vault_incomplete "Vault is not initialized"
            _ok=0
            while IFS= read -r _id || [ -n "${_id}" ]; do
                [ -z "${_id}" ] && continue
                if [ "${_id}" = "${_nid}" ]; then
                    _ok=1
                fi
            done <<EOF
${CFV_DOMAIN_IDS}
EOF
            if [ "${_ok}" -ne 1 ]; then
                out_die_code vault_invalid "Unknown domain-id"
            fi
            cf_vault_index_rebuild "${CFV_DOMAIN_IDS}" "${_nid}"
            if [ "${JSON}" -eq 1 ]; then
                out_json "success" "Default domain set" "command" "vault" "default_domain_id" "${_nid}"
            else
                out_success "Default domain ${_nid}"
            fi
            ;;
        show)
            if [ -n "${CF_VAULT_ACCT_ID:-}" ]; then
                CF_OPT_DOMAIN="${CF_VAULT_ACCT_ID}"
            fi
            cf_vault_cmd_show
            ;;
        *)
            out_die_code vault_invalid "Unknown vault account op"
            ;;
    esac
}

cf_vault_dispatch() {
    case "${CF_VAULT_ACTION:-input}" in
        input)     cf_vault_cmd_input ;;
        set|init)  cf_vault_cmd_set ;;
        show)      cf_vault_cmd_show ;;
        clear)     cf_vault_cmd_clear ;;
        subdomain) cf_vault_cmd_subdomain ;;
        account|zone) cf_vault_cmd_account ;;
        *)         out_die "Unknown command or flag: vault ${CF_VAULT_ACTION}. See '${APP_NAME} help'." ;;
    esac
}

cf_select_label() {
    _want="${CF_OPT_SUBDOMAIN:-}"
    if [ -z "${_want}" ] && [ -n "${CF_POS_LABEL:-}" ]; then
        _want="${CF_POS_LABEL}"
    fi
    if [ -n "${_want}" ]; then
        CF_SEL_LABEL=$(cf_norm_label "${_want}" "${CFV_DOMAIN}")
        CF_SEL_MODE=$(cf_vault_label_mode "${CF_SEL_LABEL}" || echo "non-round-robin")
        return 0
    fi
    _n=0
    _only=""
    while IFS= read -r _lab || [ -n "${_lab}" ]; do
        [ -z "${_lab}" ] && continue
        _n=$((_n + 1))
        _only="${_lab}"
    done <<EOF
${CFV_SUBDOMAINS}
EOF
    if [ "${_n}" -eq 1 ]; then
        CF_SEL_LABEL="${_only}"
        CF_SEL_MODE=$(cf_vault_label_mode "${CF_SEL_LABEL}" || echo "non-round-robin")
        return 0
    fi
    out_die_code subdomain_required "Pass --subdomain (vault has ${_n} labels)"
}

cf_unlink_hdr() {
    if [ -n "${CF_HDR_FILE:-}" ] && [ -f "${CF_HDR_FILE}" ]; then
        rm -f "${CF_HDR_FILE}"
        CF_HDR_FILE=""
    fi
}

cf_api_curl() {
    _method="$1"
    _url="$2"
    _data="${3:-}"
    cf_vault_dir
    : "${CF_CURL:=curl}"
    : "${CFV_TOKEN:=}"
    if [ -z "${CFV_TOKEN}" ]; then
        out_die_code vault_incomplete "API token missing"
    fi
    CF_HDR_FILE=$(mktemp "${CFV_DIR}/.curl-hdr.XXXXXX") || out_die_code vault_insecure "Cannot create curl --config in vault dir"
    chmod 0600 "${CF_HDR_FILE}"
    {
        printf 'header = "Authorization: Bearer %s"\n' "${CFV_TOKEN}"
        printf 'header = "Accept: application/json"\n'
        if [ -n "${_data}" ]; then
            printf 'header = "Content-Type: application/json"\n'
        fi
    } >"${CF_HDR_FILE}"
    _body=$(mktemp "${CFV_DIR}/.curl-body.XXXXXX") || out_die_code vault_insecure "Cannot create API body temp"
    chmod 0600 "${_body}"
    set -- --config "${CF_HDR_FILE}" -sS --connect-timeout 5 --max-time 15 \
        -o "${_body}" -w '%{http_code}' -X "${_method}" "${_url}"
    if [ -n "${_data}" ]; then
        _df=$(mktemp "${CFV_DIR}/.curl-data.XXXXXX")
        chmod 0600 "${_df}"
        printf '%s' "${_data}" >"${_df}"
        set -- "$@" --data-binary "@${_df}"
    fi
    CF_API_HTTP=$("${CF_CURL}" "$@") || CF_API_HTTP="000"
    cf_unlink_hdr
    if [ -n "${_df:-}" ]; then
        rm -f "${_df}"
    fi
    CF_API_BODY="${_body}"
}

# ALIGNMENT: requirement-external-ipv4.md (IP-M1..M5, IP-M7)
cf_ip_lookup() {
    if [ -n "${CF_OPT_IP:-}" ]; then
        if ! cf_ipv4_ok "${CF_OPT_IP}"; then
            out_die_code ip_lookup_failed "Invalid or disallowed IPv4: ${CF_OPT_IP}"
        fi
        CF_PUBLIC_IP="${CF_OPT_IP}"
        CF_IP_SOURCE="override"
        return 0
    fi
    : "${CF_CURL:=curl}"
    : "${EFFECTIVE_STORAGE_DIR:=${TMPDIR:-/tmp}}"
    _body=$(mktemp "${EFFECTIVE_STORAGE_DIR}/.ipinfo.XXXXXX") || out_die_code ip_lookup_failed "Cannot create ipinfo temp"
    chmod 0600 "${_body}"
    CF_IP_SOURCE="ipinfo"
    _http=$("${CF_CURL}" -sS --connect-timeout 5 --max-time 15 \
        -H "Accept: application/json" -o "${_body}" -w '%{http_code}' \
        "https://ipinfo.io") || _http="000"
    if [ "${_http}" = "429" ] || [ "${_http}" != "200" ]; then
        rm -f "${_body}"
        out_die_code ip_lookup_failed "ipinfo.io lookup failed (HTTP ${_http})"
    fi
    _ip=$(cf_json_get "${_body}" "ip" 2>/dev/null || echo "")
    rm -f "${_body}"
    if ! cf_ipv4_ok "${_ip}"; then
        out_die_code ip_lookup_failed "ipinfo.io returned invalid IPv4"
    fi
    CF_PUBLIC_IP="${_ip}"
    CF_IP_SOURCE="ipinfo"
}

