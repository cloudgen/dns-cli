    _vdom=""
    _sc=0
    _dc=0
    if [ -n "${_vdir}" ] && [ -f "${_vdir}/index.json" ]; then
        _dc=$(cf_json_get "${_vdir}/index.json" "domain_ids.length" 2>/dev/null || echo "0")
        _vdom=$(cf_json_get "${_vdir}/index.json" "default_domain_id" 2>/dev/null || echo "")
        if [ "${_vdom}" = "null" ]; then
            _vdom=""
        fi
    fi
    if [ -n "${_vdir}" ] && [ -n "${_vdom}" ] && [ -f "${_vdir}/accounts/${_vdom}/token" ]; then
        _tp="true"
    fi
    if [ -n "${_vdir}" ] && [ -n "${_vdom}" ] && [ -f "${_vdir}/accounts/${_vdom}/vault.json" ]; then
        _vz=$(cf_json_get "${_vdir}/accounts/${_vdom}/vault.json" "zone_id" 2>/dev/null || echo "")
        _va=$(cf_json_get "${_vdir}/accounts/${_vdom}/vault.json" "account_id" 2>/dev/null || echo "")
        _vu=$(cf_json_get "${_vdir}/accounts/${_vdom}/vault.json" "user_id" 2>/dev/null || echo "")
        [ -n "${_vz}" ] && _zid_set="true"
        [ -n "${_va}" ] && _aid_set="true"
        [ -n "${_vu}" ] && _uid_set="true"
        _sc=$(cf_json_get "${_vdir}/accounts/${_vdom}/vault.json" "subdomains.length" 2>/dev/null || echo "0")
    fi

    if [ "${JSON}" -eq 1 ]; then
        out_json "about" "" \
            "app" "${APP_NAME}" \
            "version" "${VERSION}" \
            "repo_user" "${REPO_USER}" \
            "repo_name" "${REPO_NAME}" \
            "repository" "${REPO_USER}/${REPO_NAME}" \
            "script_url" "${SCRIPT_URL}" \
            "installed" "${_installed}" \
            "global_version" "${_global_ver}" \
            "local_version" "${_local_ver}" \
            "shell" "${_shell}" \
            "interactive" "${_interactive}" \
            "user" "${_user}" \
            "effective_storage" "${EFFECTIVE_STORAGE_DIR}" \
            "storage_dir" "${STORAGE_DIR}" \
            "vault_dir" "${_vdir}" \
            "token_present" "${_tp}" \
            "zone_id_set" "${_zid_set}" \
            "account_id_set" "${_aid_set}" \
            "user_id_set" "${_uid_set}" \
            "domain" "${_vdom}" \
            "domain_count" "${_dc}" \
            "subdomain_count" "${_sc}" \
            "lpu_present" "${_lpu}"
        return 0
    fi

    [ "${QUIET}" -eq 1 ] && return 0

    out_info "=== ${APP_NAME} ${VERSION} - About / Diagnostics ==="
    out_empty_line
    if [ "${_installed}" = "true" ]; then
        out_success "${APP_NAME} is properly installed."
    else
        out_warn "${APP_NAME} is NOT installed in a managed bin path."
        out_info "   Recommended: ${APP_NAME} install   (local copy → ${USER_BIN}/${APP_NAME})"
    fi
    out_empty_line
    out_info "Global install  (${GLOBAL_BIN}/${APP_NAME}):   ${_global_ver}"
    out_info "Local install   (${USER_BIN}/${APP_NAME}):    ${_local_ver}"
    out_empty_line
    out_info "Repository:        ${REPO_USER}/${REPO_NAME}"
    if [ -n "${SCRIPT_URL}" ]; then
        out_info "Install channel:   ${SCRIPT_URL}"
    else
        out_info "Install channel:   (empty — local install only)"
    fi
    out_empty_line
    out_info "Current user:      ${_user}"
    out_info "LPU dns-adm:       ${_lpu}"
    if [ "$(id -u)" -eq 0 ]; then
        out_success "Execution context: root"
    else
        out_info "Execution context: normal user (Type 0 lifecycle)"
    fi
    out_empty_line
    out_info "Current shell:     ${_shell}"
    if [ "${TTY:-0}" -eq 1 ]; then
        out_info "TTY / Interactive: yes"
    else
        out_info "TTY / Interactive: no"
    fi
    out_empty_line
    out_info "Storage (effective): ${EFFECTIVE_STORAGE_DIR}"
    out_info "Storage (fallback):  ${STORAGE_DIR}"
    out_empty_line
    out_info "Vault dir:         ${_vdir:-"(unset / insecure HOME)"}"
    out_info "Token present:     ${_tp}"
    out_info "Domain:            ${_vdom}"
    out_info "Subdomain count:   ${_sc}"
    out_empty_line
    out_info "Useful commands:"
    out_info "   ${APP_NAME} help            → Full usage"
    out_info "   ${APP_NAME} vault input     → Interactive vault (TTY)"
    out_info "   ${APP_NAME} vault set       → Store credentials from flags/files"
    out_info "   ${APP_NAME} ip              → Show public IPv4 (no vault)"
    out_info "   ${APP_NAME} add --ip A.B.C.D → Ensure single A record"
    out_info "   ${APP_NAME} --json          → Machine-readable output"
}

# =============================================================================
# cf_req_* — DNS inbound file-based JSON approval
# =============================================================================
#
# GENERAL PURPOSE:
# Type 0 submit drops a self-scoped Cloudflare DNS request into inbound.
# Type 1 approve/reject/interactive re-check and move the file. Accept applies
# dest via existing vault DNS/mode verbs.
#
# ALIGNMENT:
# - requirement-dns-actor-table.md
# - requirement-cloudflare-dns-request.md
# - requirement-domain-cloudflare-dns.md
# - requirement-dns-approver.md
#
# Last reviewed: 2026-08-18
# =============================================================================

cf_req_public_root() {
    : "${APP_NAME:=dns-cli}"
    if [ -n "${DNS_QUEUE_ROOT:-}" ]; then
        printf '%s' "${DNS_QUEUE_ROOT}"
        return 0
    fi
    if [ -n "${CF_LPU_ROOT:-}" ]; then
        printf '%s/var/%s' "${CF_LPU_ROOT}" "${APP_NAME}"
        return 0
    fi
    printf '/var/%s' "${APP_NAME}"
}

cf_req_detect_inbound() {
    : "${DNS_INBOUND_BASENAME:=dns-request}"
    if [ -n "${DNS_QUEUE_INBOUND:-}" ] && [ -d "${DNS_QUEUE_INBOUND}" ]; then
        printf '%s' "${DNS_QUEUE_INBOUND}"
        return 0
    fi
    _root=$(cf_req_public_root)
    if [ -d "${_root}/${DNS_INBOUND_BASENAME}" ]; then
        printf '%s' "${_root}/${DNS_INBOUND_BASENAME}"
        return 0
    fi
    return 1
}

cf_req_sibling_dir() {
    _in="$1"
    _name="$2"
    printf '%s/%s' "$(dirname -- "${_in}")" "${_name}"
}

cf_req_install_trio() {
    : "${APP_NAME:=dns-cli}"
    : "${DNS_INBOUND_BASENAME:=dns-request}"
    : "${DNS_ACCEPTED_BASENAME:=dns-accepted}"
    : "${DNS_DECLINED_BASENAME:=dns-declined}"
    _root=$(cf_req_public_root)
    _u=$(lpu_user)
    if [ ! -d "${_root}" ]; then
        mkdir -p "${_root}" || out_die_code vault_insecure "Cannot create ${_root}"
    fi
    chmod 0755 "${_root}" || true
    for _n in "${DNS_INBOUND_BASENAME}" "${DNS_ACCEPTED_BASENAME}" "${DNS_DECLINED_BASENAME}"; do
        if [ ! -d "${_root}/${_n}" ]; then
            mkdir -p "${_root}/${_n}" || out_die_code vault_insecure "Cannot create ${_root}/${_n}"
        fi
    done
    chmod 3773 "${_root}/${DNS_INBOUND_BASENAME}" || true
    chmod 0700 "${_root}/${DNS_ACCEPTED_BASENAME}" || true
    chmod 0700 "${_root}/${DNS_DECLINED_BASENAME}" || true
    if ! lpu_test_mode; then
        lpu_chown_tree "${_root}"
    fi
    _home="${LPU_HOME:-}"
    if [ -z "${_home}" ]; then
        _home=$(lpu_live_home) || _home=""
    fi
    if [ -n "${_home}" ] && [ -d "${_home}" ]; then
        _view="${_home}/${DNS_INBOUND_BASENAME}"
        if [ ! -e "${_view}" ]; then
            ln -s "${_root}/${DNS_INBOUND_BASENAME}" "${_view}" 2>/dev/null || true
        fi
    fi
}

cf_req_alloc_id() {
    _in="$1"
    _subject="$2"
    _act="$3"
    [ -n "${_in}" ] && [ -d "${_in}" ] || return 1
    [ -n "${_subject}" ] && [ -n "${_act}" ] || return 1
    _root=$(dirname -- "${_in}")
    : "${DNS_ACCEPTED_BASENAME:=dns-accepted}"
    : "${DNS_DECLINED_BASENAME:=dns-declined}"
    _ad=$(date +%Y%m%d)
    _n=1
    while [ "${_n}" -le 999 ]; do
        _id="${_ad}-${_subject}-${_act}-${_n}.json"
        if [ ! -e "${_in}/${_id}" ] && \
           [ ! -e "${_root}/${DNS_ACCEPTED_BASENAME}/${_id}" ] && \
           [ ! -e "${_root}/${DNS_DECLINED_BASENAME}/${_id}" ]; then
            printf '%s' "${_id}"
            return 0
        fi
        _n=$((_n + 1))
    done
    return 1
}

cf_req_parse_basename() {
    _bn="$1"
    CF_REQ_BN_DATE=""
    CF_REQ_BN_SUBJECT=""
    CF_REQ_BN_ACTION=""
    CF_REQ_BN_N=""
    case "${_bn}" in
        *.json) ;;
        *) return 1 ;;
    esac
    _stem="${_bn%.json}"
    CF_REQ_BN_DATE=$(printf '%s' "${_stem}" | cut -d- -f1)
    CF_REQ_BN_SUBJECT=$(printf '%s' "${_stem}" | cut -d- -f2)
    CF_REQ_BN_ACTION=$(printf '%s' "${_stem}" | cut -d- -f3)
    CF_REQ_BN_N=$(printf '%s' "${_stem}" | cut -d- -f4)
    printf '%s' "${CF_REQ_BN_DATE}" | grep -Eq '^[0-9]{8}$' || return 1
    [ -n "${CF_REQ_BN_SUBJECT}" ] && [ -n "${CF_REQ_BN_ACTION}" ] && [ -n "${CF_REQ_BN_N}" ] || return 1
    case "${CF_REQ_BN_ACTION}" in
        add|update|remove|mode) ;;
        *) return 1 ;;
    esac
    return 0
}

cf_req_field() {
    _jf="$1"
    _key="$2"
    cf_json_get "${_jf}" "${_key}" 2>/dev/null || true
}

# Dest fencing (file-based JSON subclass): incorrect JSON format only.
# Returns 0 if clear; 1 if a fence matched (sets CF_REQ_FENCE_MSG).
# User SSOT is the JSON subject field, not the filename token.
# MUST NOT check who submitted / file-ownership / subject == dest LPU.
cf_req_dest_fence() {
    _jf="$1"
    : "${APP_NAME:=dns-cli}"
    CF_REQ_FENCE_KIND=""
    CF_REQ_FENCE_MSG=""
    if [ ! -f "${_jf}" ] || [ -L "${_jf}" ]; then
        CF_REQ_FENCE_KIND="incorrect_json_format"
        CF_REQ_FENCE_MSG="This waiting file is missing, is a shortcut (symlink), or is not a regular file. Dest will not ask yes or no. Next: put a real JSON request in the waiting folder."
        return 1
    fi
    _bn=$(basename -- "${_jf}")
    if ! cf_req_parse_basename "${_bn}"; then
        CF_REQ_FENCE_KIND="incorrect_json_format"
        CF_REQ_FENCE_MSG="The file name ${_bn} is not a DNS request name (YYYYMMDD-subject-action-n.json). Dest will not ask yes or no. Next: rename or submit a new file."
        return 1
    fi
    _uk=$(python3 -c '
import json,sys
allowed={"schema_version","purpose","subject","action","domain_id","subdomain","ipv4","from_ipv4","mode","ttl","proxied","submit_by"}
forbidden=("token","CF_API_TOKEN","user_id","api_token")
path=sys.argv[1]
with open(path, encoding="utf-8") as fh:
    data=json.load(fh)
if not isinstance(data, dict):
    print("not-object")
    raise SystemExit(2)
for k in data:
    if k in forbidden:
        print("secret:"+k)
        raise SystemExit(3)
    if k not in allowed:
        print("unknown:"+k)
        raise SystemExit(3)
print("ok")
' "${_jf}")
    _prc=$?
    if [ "${_prc}" -ne 0 ]; then
        CF_REQ_FENCE_KIND="incorrect_json_format"
        case "${_uk}" in
            secret:*)
                CF_REQ_FENCE_MSG="This waiting file must not contain a token or user_id. Dest will not ask yes or no. Next: remove those keys and ${APP_NAME} submit again."
                ;;
            unknown:*)
                CF_REQ_FENCE_MSG="This waiting file has an unknown key. Dest will not ask yes or no. Next: use only the documented request keys and ${APP_NAME} submit again."
                ;;
            *)
                CF_REQ_FENCE_MSG="This waiting file is not a JSON object. Dest will not ask yes or no. Next: write one JSON object and ${APP_NAME} submit again."
                ;;
        esac
        return 1
    fi
    _sv=$(cf_req_field "${_jf}" "schema_version")
    if [ "${_sv}" != "1" ]; then
        CF_REQ_FENCE_KIND="incorrect_json_format"
        CF_REQ_FENCE_MSG="This waiting file schema_version must be 1. Dest will not ask yes or no. Next: set schema_version to 1 and ${APP_NAME} submit again."
        return 1
    fi
    _purpose=$(cf_req_field "${_jf}" "purpose")
    _subject=$(cf_req_field "${_jf}" "subject")
    _action=$(cf_req_field "${_jf}" "action")
    _dom=$(cf_req_field "${_jf}" "domain_id")
    _sub=$(cf_req_field "${_jf}" "subdomain")
    if [ -z "${_purpose}" ] || [ -z "${_subject}" ] || [ -z "${_action}" ] || [ -z "${_dom}" ] || [ -z "${_sub}" ]; then
        CF_REQ_FENCE_KIND="incorrect_json_format"
        CF_REQ_FENCE_MSG="This waiting file is missing a required field (purpose, subject, action, domain_id, subdomain). Dest will not ask yes or no."
        return 1
    fi
    case "${_action}" in
        add|update|remove|mode) ;;
        *)
            CF_REQ_FENCE_KIND="incorrect_json_format"
            CF_REQ_FENCE_MSG="This waiting file action must be add, update, remove, or mode. Dest will not ask yes or no."
            return 1
            ;;
    esac
    if [ "${_action}" != "${CF_REQ_BN_ACTION}" ]; then
        CF_REQ_FENCE_KIND="incorrect_json_format"
        CF_REQ_FENCE_MSG="This waiting file action ${_action} does not match basename type ${CF_REQ_BN_ACTION}. Dest will not ask yes or no."
        return 1
    fi
    # User SSOT is JSON subject, not the filename token. Do not fence on basename subject.
    _ipv4=$(cf_req_field "${_jf}" "ipv4")
    _from=$(cf_req_field "${_jf}" "from_ipv4")
    _mode=$(cf_req_field "${_jf}" "mode")
    _ttl=$(cf_req_field "${_jf}" "ttl")
    _prox=$(cf_req_field "${_jf}" "proxied")
    case "${_ipv4}${_from}" in
        *:*)
            CF_REQ_FENCE_KIND="incorrect_json_format"
            CF_REQ_FENCE_MSG="This waiting file IPv4 fields must not be IPv6. Dest will not ask yes or no."
            return 1
            ;;
    esac
    case "${_action}" in
        add)
            if [ -z "${_ipv4}" ]; then
                CF_REQ_FENCE_KIND="incorrect_json_format"
                CF_REQ_FENCE_MSG="This waiting add request needs ipv4. Dest will not ask yes or no."
                return 1
            fi
            if [ -n "${_from}" ] || [ -n "${_mode}" ]; then
                CF_REQ_FENCE_KIND="incorrect_json_format"
                CF_REQ_FENCE_MSG="This waiting add request must not include from_ipv4 or mode. Dest will not ask yes or no."
                return 1
            fi
            if ! cf_ipv4_ok "${_ipv4}"; then
                CF_REQ_FENCE_KIND="incorrect_json_format"
                CF_REQ_FENCE_MSG="This waiting file ipv4 is not a public IPv4: ${_ipv4}. Dest will not ask yes or no."
                return 1
            fi
            ;;
        update)
            if [ -z "${_ipv4}" ]; then
                CF_REQ_FENCE_KIND="incorrect_json_format"
                CF_REQ_FENCE_MSG="This waiting update request needs ipv4. Dest will not ask yes or no."
                return 1
            fi
            if [ -n "${_mode}" ]; then
                CF_REQ_FENCE_KIND="incorrect_json_format"
                CF_REQ_FENCE_MSG="This waiting update request must not include mode. Dest will not ask yes or no."
                return 1
            fi
            if ! cf_ipv4_ok "${_ipv4}"; then
                CF_REQ_FENCE_KIND="incorrect_json_format"
                CF_REQ_FENCE_MSG="This waiting file ipv4 is not a public IPv4: ${_ipv4}. Dest will not ask yes or no."
                return 1
            fi
            if [ -n "${_from}" ] && ! cf_ipv4_ok "${_from}"; then
                CF_REQ_FENCE_KIND="incorrect_json_format"
                CF_REQ_FENCE_MSG="This waiting file from_ipv4 is not a public IPv4: ${_from}. Dest will not ask yes or no."
                return 1
            fi
            ;;
        remove)
            if [ -n "${_from}" ] || [ -n "${_mode}" ] || [ -n "${_ttl}" ] || [ -n "${_prox}" ]; then
                CF_REQ_FENCE_KIND="incorrect_json_format"
                CF_REQ_FENCE_MSG="This waiting remove request must not include from_ipv4, mode, ttl, or proxied. Dest will not ask yes or no."
                return 1
            fi
            if [ -n "${_ipv4}" ] && ! cf_ipv4_ok "${_ipv4}"; then
                CF_REQ_FENCE_KIND="incorrect_json_format"
                CF_REQ_FENCE_MSG="This waiting file ipv4 is not a public IPv4: ${_ipv4}. Dest will not ask yes or no."
                return 1
            fi
            ;;
        mode)
            if [ -z "${_mode}" ]; then
                CF_REQ_FENCE_KIND="incorrect_json_format"
                CF_REQ_FENCE_MSG="This waiting mode request needs mode. Dest will not ask yes or no."
                return 1
            fi
            case "${_mode}" in
                non-round-robin|round-robin) ;;
                *)
                    CF_REQ_FENCE_KIND="incorrect_json_format"
                    CF_REQ_FENCE_MSG="This waiting file mode must be non-round-robin or round-robin. Dest will not ask yes or no."
                    return 1
                    ;;
            esac
            if [ -n "${_ipv4}" ] || [ -n "${_from}" ] || [ -n "${_ttl}" ] || [ -n "${_prox}" ]; then
                CF_REQ_FENCE_KIND="incorrect_json_format"
                CF_REQ_FENCE_MSG="This waiting mode request must not include ipv4, from_ipv4, ttl, or proxied. Dest will not ask yes or no."
                return 1
            fi
            ;;
    esac
    CF_REQ_PURPOSE="${_purpose}"
    CF_REQ_SUBJECT="${_subject}"
    CF_REQ_ACTION="${_action}"
    CF_REQ_DOMAIN="${_dom}"
    CF_REQ_SUBDOMAIN="${_sub}"
    CF_REQ_IPV4="${_ipv4}"
    CF_REQ_FROM="${_from}"
    CF_REQ_MODE="${_mode}"
    CF_REQ_TTL="${_ttl}"
    CF_REQ_PROXIED="${_prox}"
    CF_REQ_SUBMIT_BY=$(cf_req_field "${_jf}" "submit_by")
    return 0
}

cf_req_explain_fence() {
    _src="$1"
    : "${APP_NAME:=dns-cli}"
    _bn=$(basename -- "${_src}")
    out_warn "Waiting file ${_bn} is blocked by a fencing condition (incorrect JSON format)."
    out_plain "${CF_REQ_FENCE_MSG}"
    out_plain "This file was not offered for yes or no. Next: fix the JSON and ${APP_NAME} submit it again."
}

cf_req_verify() {
    _jf="$1"
    # Approve omits _who. Dest inbound fence is incorrect JSON format only.
    # File-ownership is not a dest wall; cf_req_move takes it as dns-adm.
    _who="${2:-}"
    : "${APP_NAME:=dns-cli}"
    if ! cf_req_dest_fence "${_jf}"; then
        out_die_code request_invalid "${CF_REQ_FENCE_MSG}"
    fi
    if [ -n "${_who}" ] && [ "${CF_REQ_SUBJECT}" != "${_who}" ]; then
        out_die_code request_invalid "DNS request is self-scope only. subject ${CF_REQ_SUBJECT} is not ${_who}. Path: ${_jf}"
    fi
    return 0
}

cf_req_require_approver() {
    _verb="$1"
    : "${APP_NAME:=dns-cli}"
    _lpu=$(lpu_user)
    _who=$(id -un 2>/dev/null || echo "unknown")
    if lpu_test_mode; then
        return 0
    fi
    if [ "${_who}" = "${_lpu}" ]; then
        return 0
    fi
    if [ "$(id -u 2>/dev/null || echo 1)" -eq 0 ]; then
        return 0
    fi
    out_die_code lpu_required "${_verb} must run as ${_lpu}. You are ${_who}. Next: sudo -u ${_lpu} ${APP_NAME} ${_verb}  or log in as ${_lpu}"
}

cf_req_apply() {
    : "${APP_NAME:=dns-cli}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    _act="${CF_REQ_ACTION}"
    CF_OPT_DOMAIN="${CF_REQ_DOMAIN}"
    CF_OPT_DOMAIN_ID="${CF_REQ_DOMAIN}"
    CF_OPT_SUBDOMAIN="${CF_REQ_SUBDOMAIN}"
    if [ -n "${CF_REQ_TTL}" ]; then
        CF_OPT_TTL="${CF_REQ_TTL}"
    fi
    if [ -n "${CF_REQ_PROXIED}" ]; then
        CF_OPT_PROXIED="${CF_REQ_PROXIED}"
    fi
    if [ -n "${CF_REQ_IPV4}" ]; then
        CF_OPT_IP="${CF_REQ_IPV4}"
    fi
    if [ -n "${CF_REQ_FROM}" ]; then
        CF_OPT_FROM="${CF_REQ_FROM}"
    fi
    if [ -n "${CF_REQ_MODE}" ]; then
        CF_OPT_MODE="${CF_REQ_MODE}"
    fi
    if lpu_test_mode || lpu_invoker_is_lpu; then
        case "${_act}" in
            add) cf_dns_add ;;
            update) cf_dns_update ;;
            remove) cf_dns_remove ;;
            mode)
                CF_VAULT_SUB_OP="mode"
                CF_VAULT_SUB_LABEL="${CF_REQ_SUBDOMAIN}"
                CF_VAULT_SUB_MODE="${CF_REQ_MODE}"
                cf_vault_cmd_subdomain
                ;;
        esac
        return 0
    fi
    _gbin="${GLOBAL_BIN}/${APP_NAME}"
    _lpu=$(lpu_user)
    if [ ! -x "${_gbin}" ]; then
        out_die_code lpu_required "Approve apply must run as ${_lpu}. Global CLI is missing at ${_gbin}. Next: sudo ${APP_NAME} install"
    fi
    set -- --json
    if [ -n "${CF_OPT_VAULT_DIR:-}" ]; then
        set -- "$@" --vault-dir "${CF_OPT_VAULT_DIR}"
    fi
    case "${_act}" in
        add)
            set -- "$@" add --domain "${CF_REQ_DOMAIN}" --subdomain "${CF_REQ_SUBDOMAIN}" --ip "${CF_REQ_IPV4}"
            ;;
        update)
            set -- "$@" update --domain "${CF_REQ_DOMAIN}" --subdomain "${CF_REQ_SUBDOMAIN}" --ip "${CF_REQ_IPV4}"
            if [ -n "${CF_REQ_FROM}" ]; then
                set -- "$@" --from "${CF_REQ_FROM}"
            fi
            ;;
        remove)
            set -- "$@" remove --domain "${CF_REQ_DOMAIN}" --subdomain "${CF_REQ_SUBDOMAIN}"
            if [ -n "${CF_REQ_IPV4}" ]; then
                set -- "$@" --ip "${CF_REQ_IPV4}"
            fi
            ;;
        mode)
            set -- "$@" vault subdomain mode "${CF_REQ_SUBDOMAIN}" "${CF_REQ_MODE}" --domain "${CF_REQ_DOMAIN}"
            ;;
    esac
    if ! sudo -n -u "${_lpu}" -- "${_gbin}" "$@"; then
        out_die_code lpu_required "Could not apply the DNS request as ${_lpu}. Next: ${APP_NAME} generate-sudoer-request then ${APP_NAME} submit-sudoer-request"
    fi
}

cf_req_submit() {
    : "${APP_NAME:=dns-cli}"
    : "${JSON:=0}"
    _src="${1:-}"
    _who=$(id -un 2>/dev/null || echo "unknown")
    if [ -z "${_src}" ]; then
        out_die_code request_invalid "submit needs a DNS request JSON file. Next: write a file then ${APP_NAME} submit /path/to/file.json"
    fi
    _in=""
    if ! _in=$(cf_req_detect_inbound); then
        out_die_code sudoer_required "DNS inbound queue not found. Next: sudo ${APP_NAME} setup"
    fi
    if [ ! -w "${_in}" ]; then
        out_die_code sudoer_required "DNS inbound is not writable: ${_in}. Next: sudo ${APP_NAME} setup"
    fi
    _tmp="${_src}"
    _bn=$(basename -- "${_src}")
    if ! cf_req_parse_basename "${_bn}"; then
        _act=$(cf_req_field "${_src}" "action")
        _sub=$(cf_req_field "${_src}" "subject")
        if [ -z "${_sub}" ]; then
            _sub="${_who}"
        fi
        if [ -z "${_act}" ]; then
            out_die_code request_invalid "DNS request needs action add, update, remove, or mode"
        fi
        _rid=$(cf_req_alloc_id "${_in}" "${_sub}" "${_act}") || out_die_code vault_insecure "cannot allocate DNS request id"
    else
        _rid="${_bn}"
        if [ -e "${_in}/${_rid}" ]; then
            out_die_code request_invalid "DNS inbound already has ${_rid}"
        fi
    fi
    _dest="${_in}/${_rid}"
    cp "${_tmp}" "${_dest}" || out_die_code vault_insecure "cannot write ${_dest}"
    chmod 0640 "${_dest}" 2>/dev/null || true
    cf_req_verify "${_dest}" "${_who}"
    if [ -n "${CF_REQ_SUBMIT_BY}" ]; then
        rm -f "${_dest}" 2>/dev/null || true
        out_die_code request_invalid "DNS submit must not include submit_by. Dest writes that field after review. Path: ${_src}"
    fi
    if [ "${JSON}" -eq 1 ]; then
        out_json "submit" "queued" \
            "request_id" "${_rid}" \
            "action" "${CF_REQ_ACTION}" \
            "subject" "${CF_REQ_SUBJECT}" \
            "inbound" "${_in}"
        return 0
    fi
    out_success "Queued DNS ${CF_REQ_ACTION} request ${_rid}"
    out_info "inbound=${_in}  (approver: $(lpu_user))"
}

cf_req_pick() {
    _in="$1"
    _want="${2:-}"
    if [ -n "${_want}" ]; then
        _bn=$(basename -- "${_want}")
        if [ -f "${_in}/${_bn}" ]; then
            printf '%s' "${_in}/${_bn}"
            return 0
        fi
        if [ -f "${_want}" ]; then
            printf '%s' "${_want}"
            return 0
        fi
        out_die_code request_invalid "DNS request not in inbound: ${_bn}"
    fi
    _n=0
    _one=""
    for _f in "${_in}"/*.json; do
        [ -f "${_f}" ] || continue
        _n=$((_n + 1))
        if [ -z "${_one}" ]; then
            _one="${_f}"
        fi
    done
    if [ "${_n}" -eq 1 ]; then
        printf '%s' "${_one}"
        return 0
    fi
    if [ "${_n}" -eq 0 ]; then
        out_die_code request_invalid "No pending DNS requests in ${_in}"
    fi
    out_die_code request_invalid "More than one pending DNS request. Pass the request_id (basename)."
}

# Unix inode owner of a queued file (login name). Empty on failure.
cf_req_file_owner() {
    _src="$1"
    [ -n "${_src}" ] && [ -f "${_src}" ] || return 1
    _own=$(stat -c '%U' "${_src}" 2>/dev/null || stat -f '%Su' "${_src}" 2>/dev/null || true)
    [ -n "${_own}" ] || return 1
    printf '%s' "${_own}"
}

# Dest-write submit_by (human: submit by) = original file-ownership.
# Called only after dest_fence is clear.
cf_req_stamp_submit_by() {
    _jf="$1"
    _orig="$2"
    [ -n "${_jf}" ] && [ -f "${_jf}" ] && [ -n "${_orig}" ] || return 1
    python3 -c '
import json, sys
path, owner = sys.argv[1], sys.argv[2]
with open(path, encoding="utf-8") as fh:
    data = json.load(fh)
if not isinstance(data, dict):
    raise SystemExit(2)
data["submit_by"] = owner
with open(path, "w", encoding="utf-8") as fh:
    json.dump(data, fh, indent=2)
    fh.write("\n")
' "${_jf}" "${_orig}" || out_die_code vault_insecure "cannot write submit_by on ${_jf}"
    CF_REQ_SUBMIT_BY="${_orig}"
    return 0
}

# Take Unix file-ownership as the dest LPU (dns-adm). Login-hook interactive
# MUST do this at the beginning, before review. Queue move assumes that change.
cf_req_take_ownership() {
    _src="$1"
    if lpu_test_mode; then
        return 0
    fi
    [ -n "${_src}" ] && [ -f "${_src}" ] || return 1
    [ -L "${_src}" ] && return 1
    _owner=$(lpu_user)
    if ! chown "${_owner}:${_owner}" "${_src}" 2>/dev/null && ! chown "${_owner}" "${_src}" 2>/dev/null; then
        out_die_code vault_insecure "cannot chown ${_src} to ${_owner} (login-hook review takes ownership at the beginning)"
    fi
    return 0
}

# Interactive take-ownership: record original file-ownership, take as the
# corresponding LPU, review JSON format, if clear add submit_by.
cf_req_take_inbound_ownership() {
    _in="$1"
    [ -n "${_in}" ] && [ -d "${_in}" ] || return 0
    for _f in "${_in}"/*.json; do
        [ -f "${_f}" ] || continue
        [ -L "${_f}" ] && continue
        _orig=$(cf_req_file_owner "${_f}") || _orig=""
        if [ -z "${_orig}" ]; then
            out_die_code vault_insecure "cannot read original file-ownership of ${_f}"
        fi
        cf_req_take_ownership "${_f}"
        if cf_req_dest_fence "${_f}"; then
            cf_req_stamp_submit_by "${_f}" "${_orig}"
        fi
    done
}

cf_req_move() {
    _src="$1"
    _kind="$2"
    _in=$(dirname -- "${_src}")
    : "${DNS_ACCEPTED_BASENAME:=dns-accepted}"
    : "${DNS_DECLINED_BASENAME:=dns-declined}"
    if [ "${_kind}" = "accepted" ]; then
        _dest_dir=$(cf_req_sibling_dir "${_in}" "${DNS_ACCEPTED_BASENAME}")
    else
        _dest_dir=$(cf_req_sibling_dir "${_in}" "${DNS_DECLINED_BASENAME}")
    fi
    if [ ! -d "${_dest_dir}" ]; then
        out_die_code sudoer_required "DNS ${_kind} folder missing: ${_dest_dir}. Next: sudo ${APP_NAME} setup"
    fi
    _bn=$(basename -- "${_src}")
    # Queue move assumes prior ownership change to the approver.
    cf_req_take_ownership "${_src}"
    mv "${_src}" "${_dest_dir}/${_bn}" || out_die_code vault_insecure "cannot move ${_src} to ${_dest_dir}"
    printf '%s' "${_dest_dir}/${_bn}"
}

cf_req_approve() {
    : "${APP_NAME:=dns-cli}"
    : "${JSON:=0}"
    cf_req_require_approver "approve"
    _in=""
    if ! _in=$(cf_req_detect_inbound); then
        out_die_code sudoer_required "DNS inbound queue not found. Next: sudo ${APP_NAME} setup"
    fi
    _src=$(cf_req_pick "${_in}" "${1:-}")
    cf_req_verify "${_src}"
    cf_req_apply
    _moved=$(cf_req_move "${_src}" "accepted")
    if [ "${JSON}" -eq 1 ]; then
        out_json "approve" "accepted" \
            "request_id" "$(basename -- "${_moved}")" \
            "action" "${CF_REQ_ACTION}" \
            "path" "${_moved}"
        return 0
    fi
    out_success "Accepted DNS ${CF_REQ_ACTION} request $(basename -- "${_moved}")"
}

cf_req_reject() {
    : "${APP_NAME:=dns-cli}"
    : "${JSON:=0}"
    cf_req_require_approver "reject"
    _in=""
    if ! _in=$(cf_req_detect_inbound); then
        out_die_code sudoer_required "DNS inbound queue not found. Next: sudo ${APP_NAME} setup"
    fi
    _src=$(cf_req_pick "${_in}" "${1:-}")
    cf_req_verify "${_src}"
    _moved=$(cf_req_move "${_src}" "declined")
    if [ "${JSON}" -eq 1 ]; then
        out_json "reject" "declined" \
            "request_id" "$(basename -- "${_moved}")" \
            "action" "${CF_REQ_ACTION}" \
            "path" "${_moved}"
        return 0
    fi
    out_success "Declined DNS ${CF_REQ_ACTION} request $(basename -- "${_moved}")"
}

cf_req_interactive() {
    : "${APP_NAME:=dns-cli}"
    : "${JSON:=0}"
    : "${TTY:=0}"
    cf_req_require_approver "interactive"
    if [ "${JSON}" -eq 1 ] || [ "${TTY}" -ne 1 ]; then
        out_die_code confirm_required "interactive requires a TTY. Do not use --json. Next: log in as $(lpu_user) or run without --json on a terminal"
    fi
    _in=""
    if ! _in=$(cf_req_detect_inbound); then
        out_info "no pending requests"
        return 0
    fi
    # Login hook: take file-ownership as dns-adm at the beginning, then review.
    cf_req_take_inbound_ownership "${_in}"
    _any=0
    for _f in "${_in}"/*.json; do
        [ -f "${_f}" ] || continue
        _any=1
        # Approval system: fence first. Match → human-facing explain; no question.
        if ! cf_req_dest_fence "${_f}"; then
            cf_req_explain_fence "${_f}"
            continue
        fi
        out_info "request $(basename -- "${_f}")"
        out_plain "purpose: ${CF_REQ_PURPOSE}"
        out_plain "action:  ${CF_REQ_ACTION}  domain: ${CF_REQ_DOMAIN}  subdomain: ${CF_REQ_SUBDOMAIN}"
        if [ -n "${CF_REQ_SUBMIT_BY}" ]; then
            out_plain "submit by: ${CF_REQ_SUBMIT_BY}"
        fi
        if [ -n "${CF_REQ_IPV4}" ]; then
            out_plain "ipv4:    ${CF_REQ_IPV4}"
        fi
        if [ -n "${CF_REQ_MODE}" ]; then
            out_plain "mode:    ${CF_REQ_MODE}"
        fi
        # One-off approval question: yes = approve, no = reject (no skip/quit).
        if prompt_yes_no "Approve this request"; then
            cf_req_apply
            cf_req_move "${_f}" "accepted" >/dev/null
            out_success "Accepted $(basename -- "${_f}")"
        else
            cf_req_move "${_f}" "declined" >/dev/null
            out_success "Declined $(basename -- "${_f}")"
        fi
    done
    if [ "${_any}" -eq 0 ]; then
        out_info "no pending requests"
    fi
}

