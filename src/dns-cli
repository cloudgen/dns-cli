cf_zone_check() {
    cf_api_curl GET "https://api.cloudflare.com/client/v4/zones/${CFV_ZONE_ID}"
    if [ "${CF_API_HTTP}" != "200" ]; then
        rm -f "${CF_API_BODY}"
        out_die_code dns_api_failed "Zone GET failed (HTTP ${CF_API_HTTP})"
    fi
    _ok=$(cf_json_get "${CF_API_BODY}" "success" 2>/dev/null || echo "false")
    _zid=$(cf_json_get "${CF_API_BODY}" "result.account.id" 2>/dev/null || echo "")
    _zname=$(cf_json_get "${CF_API_BODY}" "result.name" 2>/dev/null || echo "")
    rm -f "${CF_API_BODY}"
    if [ "${_ok}" != "true" ]; then
        out_die_code dns_api_failed "Zone GET success=false"
    fi
    if [ "${_zid}" != "${CFV_ACCOUNT_ID}" ] || [ "${_zname}" != "${CFV_DOMAIN}" ]; then
        out_die_code zone_mismatch "Zone account.id or name does not match vault"
    fi
}

cf_dns_list() {
    _fqdn="$1"
    cf_api_curl GET "https://api.cloudflare.com/client/v4/zones/${CFV_ZONE_ID}/dns_records?type=A&name=${_fqdn}"
    if [ "${CF_API_HTTP}" != "200" ]; then
