# =============================================================================
# app_main() - Main entrypoint and command dispatcher
# =============================================================================
#
# GENERAL PURPOSE:
# Single dispatcher for dns-cli (Type 0 lifecycle + Cloudflare domain).
# Empty argv = Type N help (not install-ensure, not DNS).
#
# ALIGNMENT:
# - requirement-shell-cli-interface.md
# - requirement-shell-cli-zero-arguments.md
# - requirement-domain-cloudflare-dns.md
#
# Last reviewed: 2026-08-16
# =============================================================================
app_main() {
    : "${COMMAND:=help}"
    : "${QUIET:=0}"
    : "${JSON:=0}"
    : "${DEBUG:=0}"
    : "${FORCE:=0}"
    : "${FORCE_REINSTALL:=0}"
    : "${FORCE_GLOBAL:=0}"
    : "${USERNAME:=unknown}"
    : "${HOME:=/tmp}"
    : "${XDG_CACHE_HOME:=${HOME}/.cache}"
    : "${APP_NAME:=dns-cli}"
    : "${STORAGE_DIR:=${XDG_CACHE_HOME}/${APP_NAME}-${USERNAME}}"
    : "${CF_OPT_TTL:=300}"
    : "${CF_OPT_PROXIED:=false}"
    CF_OPT_IP=""
    CF_OPT_VAULT_DIR=""
    CF_OPT_SUBDOMAIN=""
    CF_OPT_ZONE_ID=""
    CF_OPT_ACCOUNT_ID=""
    CF_OPT_DOMAIN=""
    CF_OPT_DOMAIN_ID=""
    CF_OPT_USER_ID=""
    CF_OPT_TOKEN_FILE=""
    CF_OPT_MODE=""
    CF_OPT_FROM=""
    CF_OPT_LABEL=""
    CF_OPT_HOME=""
    CF_VAULT_ACTION=""
    CF_VAULT_SUB_OP=""
    CF_VAULT_SUB_LABEL=""
    CF_VAULT_SUB_MODE=""
    CF_VAULT_ACCT_OP=""
    CF_VAULT_ACCT_ID=""
    CF_POS_LABEL=""
    CF_POS1=""
    CF_POS2=""
    CF_POS3=""
    CF_POS4=""
    CF_POS5=""
    CF_POSN=0

    EFFECTIVE_STORAGE_DIR=$(util_resolve_storage)
    export EFFECTIVE_STORAGE_DIR STORAGE_DIR
    export TMPDIR="${EFFECTIVE_STORAGE_DIR}"

    # Type N: empty argv → help (no Cloudflare / ipinfo)
    if [ $# -eq 0 ]; then
        app_help
        return 0
    fi

    lpu_type2_save_argv "$@"

    while [ $# -gt 0 ]; do
        case "$1" in
            --quiet|-q) QUIET=1 ;;
            --json)     JSON=1; QUIET=1 ;;
            --debug)    DEBUG=1 ;;
            --force)    FORCE=1; FORCE_REINSTALL=1 ;;
            --global)   FORCE_GLOBAL=1; export FORCE_GLOBAL ;;
            --allow-test-local) ALLOW_TEST_LOCAL_SUDOERS=1; export ALLOW_TEST_LOCAL_SUDOERS ;;
            --add)      SUBMIT_ACTION="add"; SUBMIT_ACTION_EXPLICIT=1 ;;
            --update)   SUBMIT_ACTION="update"; SUBMIT_ACTION_EXPLICIT=1 ;;
            --kind)
                if [ -z "${2:-}" ]; then
                    out_die_code request_invalid "--kind requires type-2-switch or login-hook-elev"
                fi
                SUDOER_REQUEST_KIND="$2"
                export SUDOER_REQUEST_KIND
                shift
                ;;
            --ip|--subdomain|--zone-id|--account-id|--domain|--domain-id|--user-id|--ttl|--proxied|--token-file|--vault-dir|--mode|--from|--label|--home)
                _flg="$1"
                shift
                if [ $# -lt 1 ]; then
                    out_die_code vault_incomplete "${_flg} requires a value"
                fi
                case "${_flg}" in
                    --ip) CF_OPT_IP="$1" ;;
                    --subdomain) CF_OPT_SUBDOMAIN="$1" ;;
                    --zone-id) CF_OPT_ZONE_ID="$1" ;;
                    --account-id) CF_OPT_ACCOUNT_ID="$1" ;;
                    --domain) CF_OPT_DOMAIN="$1" ;;
                    --domain-id) CF_OPT_DOMAIN_ID="$1"; CF_OPT_DOMAIN="$1" ;;
                    --user-id) CF_OPT_USER_ID="$1" ;;
                    --ttl) CF_OPT_TTL="$1" ;;
                    --proxied) CF_OPT_PROXIED="$1" ;;
                    --token-file) CF_OPT_TOKEN_FILE="$1" ;;
                    --vault-dir) CF_OPT_VAULT_DIR="$1" ;;
                    --mode) CF_OPT_MODE="$1" ;;
                    --from) CF_OPT_FROM="$1" ;;
                    --label) CF_OPT_LABEL="$1" ;;
                    --home) CF_OPT_HOME="$1" ;;
                esac
                ;;
            --*)
                out_die "Unknown command or flag: $1. See '${APP_NAME} help'."
                ;;
            *)
                CF_POSN=$((CF_POSN + 1))
                case "${CF_POSN}" in
                    1) CF_POS1="$1" ;;
                    2) CF_POS2="$1" ;;
                    3) CF_POS3="$1" ;;
                    4) CF_POS4="$1" ;;
                    5) CF_POS5="$1" ;;
                    *)
                        out_die "Unknown command or flag: $1. See '${APP_NAME} help'."
                        ;;
                esac
                ;;
        esac
        shift
    done

    COMMAND="${CF_POS1:-help}"

    # Interactive capability SSOT — measure in main after flags; prompt_* consume TTY
    TTY=0
    [ -t 0 ] && [ -t 1 ] && TTY=1

    case "${COMMAND}" in
        install|uninstall|where-is-me|version|about|help|setup|remove-lpu)
            if [ "${CF_POSN}" -gt 1 ]; then
                out_die "Unknown command or flag: ${CF_POS2}. See '${APP_NAME} help'."
            fi
            ;;
        print-sudoers|generate-sudoer-request|submit-sudoer-request)
            if [ "${CF_POSN}" -gt 2 ]; then
                out_die "Unknown command or flag: ${CF_POS3}. See '${APP_NAME} help'."
            fi
            ;;
        vault)
            CF_VAULT_ACTION="${CF_POS2:-input}"
            case "${CF_VAULT_ACTION}" in
                input|set|init|show|clear) ;;
                account|zone)
                    CF_VAULT_ACCT_OP="${CF_POS3:-list}"
                    CF_VAULT_ACCT_ID="${CF_POS4:-}"
                    ;;
                subdomain)
                    CF_VAULT_SUB_OP="${CF_POS3:-list}"
                    CF_VAULT_SUB_LABEL="${CF_POS4:-}"
                    CF_VAULT_SUB_MODE="${CF_POS5:-}"
                    ;;
                *)
                    out_die "Unknown command or flag: vault ${CF_VAULT_ACTION}. See '${APP_NAME} help'."
                    ;;
            esac
            ;;
        ip)
            if [ "${CF_POSN}" -gt 1 ]; then
                out_die "Unknown command or flag: ${CF_POS2}. See '${APP_NAME} help'."
            fi
            ;;
        add|update|remove|status|show)
            CF_POS_LABEL="${CF_POS2:-}"
            if [ "${CF_POSN}" -gt 2 ]; then
                out_die "Unknown command or flag: ${CF_POS3}. See '${APP_NAME} help'."
            fi
            ;;
        submit|approve|reject)
            if [ "${CF_POSN}" -gt 2 ]; then
                out_die "Unknown command or flag: ${CF_POS3}. See '${APP_NAME} help'."
            fi
            ;;
        interactive)
            if [ "${CF_POSN}" -gt 1 ]; then
                out_die "Unknown command or flag: ${CF_POS2}. See '${APP_NAME} help'."
            fi
            ;;
        *)
            out_die "Unknown command or flag: ${COMMAND}. See '${APP_NAME} help'."
            ;;
    esac

    out_debug "dispatch command=${COMMAND} quiet=${QUIET} json=${JSON} force=${FORCE} force_global=${FORCE_GLOBAL}"

    lpu_type2_maybe_reexec

    cf_approver_heal_login_rc

    case "${COMMAND}" in
        version)      app_version ;;
        about)        app_about ;;
        install)      inst_local_install ;;
        uninstall)    inst_local_uninstall ;;
        where-is-me)  app_where_is_me ;;
        setup)        lpu_setup ;;
        remove-lpu)   lpu_remove ;;
        print-sudoers) lpu_print_sudoers ;;
        generate-sudoer-request) lpu_generate_sudoer_request "${CF_POS2:-}" ;;
        submit-sudoer-request) lpu_submit_sudoer_request "${CF_POS2:-}" ;;
        vault)        cf_vault_dispatch ;;
        ip)           cf_ip_show ;;
        add)          cf_dns_add ;;
        update)       cf_dns_update ;;
        remove)       cf_dns_remove ;;
        status|show)  cf_dns_status ;;
        submit)       cf_req_submit "${CF_POS2:-}" ;;
        approve)      cf_req_approve "${CF_POS2:-}" ;;
        reject)       cf_req_reject "${CF_POS2:-}" ;;
        interactive)  cf_req_interactive ;;
        help)         app_help ;;
        *)            app_help ;;
    esac
}

