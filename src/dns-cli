# =============================================================================
# cf_dns_resolve() - Real A lookup of an FQDN (resolver, not Cloudflare API)
# =============================================================================
#
# GENERAL PURPOSE:
# Ask the system resolver (or dig/host/nslookup) what A the FQDN has now.
# Tests set CF_TEST_RESOLVE_IP to avoid public DNS. Empty result is honest
# NXDOMAIN / no A — does not die.
#
# ALIGNMENT:
# - requirement-domain-cloudflare-dns.md
#
# Last reviewed: 2026-08-16
# =============================================================================
cf_dns_resolve() {
    _rfqdn="$1"
    CF_RESOLVED_IP=""
    CF_RESOLVED_COUNT=0
    if [ -n "${CF_TEST_RESOLVE_IP-}" ]; then
        if cf_ipv4_ok "${CF_TEST_RESOLVE_IP}"; then
            CF_RESOLVED_IP="${CF_TEST_RESOLVE_IP}"
            CF_RESOLVED_COUNT=1
        fi
        return 0
    fi
    _raw=""
    if command -v getent >/dev/null 2>&1; then
        _raw=$(getent ahostsv4 "${_rfqdn}" 2>/dev/null || true)
        if [ -n "${_raw}" ]; then
            CF_RESOLVED_IP=$(printf '%s\n' "${_raw}" | awk '/^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+/ { print $1; exit }')
        fi
    fi
    if [ -z "${CF_RESOLVED_IP}" ] && command -v dig >/dev/null 2>&1; then
        _raw=$(dig +short +time=3 +tries=1 A "${_rfqdn}" 2>/dev/null || true)
        CF_RESOLVED_IP=$(printf '%s\n' "${_raw}" | awk '/^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ { print $1; exit }')
    fi
    if [ -z "${CF_RESOLVED_IP}" ] && command -v host >/dev/null 2>&1; then
        _raw=$(host -t A "${_rfqdn}" 2>/dev/null || true)
        CF_RESOLVED_IP=$(printf '%s\n' "${_raw}" | awk '/has address/ { print $NF; exit }')
    fi
    if [ -z "${CF_RESOLVED_IP}" ] && command -v nslookup >/dev/null 2>&1; then
        _raw=$(nslookup -type=A "${_rfqdn}" 2>/dev/null || true)
        CF_RESOLVED_IP=$(printf '%s\n' "${_raw}" | awk '/^Address: / && $2 ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ { print $2; exit }')
    fi
    if [ -n "${CF_RESOLVED_IP}" ] && cf_ipv4_ok "${CF_RESOLVED_IP}"; then
        CF_RESOLVED_COUNT=1
    else
        CF_RESOLVED_IP=""
        CF_RESOLVED_COUNT=0
    fi
}

cf_dns_status() {
    cf_dns_ensure_ready
    cf_select_label
    _lab="${CF_SEL_LABEL}"
    _fqdn=$(cf_derive_fqdn "${_lab}" "${CFV_DOMAIN}")
    cf_ip_lookup
    _ip="${CF_PUBLIC_IP}"
    cf_dns_resolve "${_fqdn}"
    _resolved="${CF_RESOLVED_IP}"
    cf_zone_check
    cf_dns_list "${_fqdn}"
    _n="${CF_DNS_COUNT}"
    : "${CF_SEL_MODE:=non-round-robin}"
    if [ "${_n}" -gt 1 ] && [ "${CF_SEL_MODE}" != "round-robin" ]; then
        rm -f "${CF_DNS_JSON}"
        out_die_code dns_multi_record "Multiple A records for ${_fqdn}"
    fi
    _cur=""
    _rid=""
    _ttl=""
    _px=""
    _ips="[]"
    if [ "${_n}" -ge 1 ]; then
        _cur=$(cf_dns_first content)
        _rid=$(cf_dns_first id)
        _ttl=$(cf_dns_first ttl)
        _px=$(cf_dns_first proxied)
        _ips=$(python3 -c '
import json,sys
with open(sys.argv[1], encoding="utf-8") as fh:
    data=json.load(fh)
print(json.dumps([r.get("content","") for r in (data.get("result") or [])], separators=(",", ":")))
' "${CF_DNS_JSON}")
    fi
    rm -f "${CF_DNS_JSON}"
    _sync="false"
    if [ -n "${_resolved}" ] && [ "${_resolved}" = "${_ip}" ]; then
        _sync="true"
    fi
    if [ "${JSON}" -eq 1 ]; then
        out_json "success" "DNS status" \
            "command" "status" "fqdn" "${_fqdn}" \
            "public_ip" "${_ip}" \
            "resolved_ip" "${_resolved}" \
            "record_ip" "${_cur}" \
            "in_sync" "${_sync}" \
            "mode" "${CF_SEL_MODE}" \
            "ipv4_count" "${_n}" \
            "@record_ips" "${_ips}" \
            "record_id" "${_rid}" "ttl" "${_ttl}" "proxied" "${_px}"
    else
        out_info "FQDN: ${_fqdn}"
        out_info "Public IP (ipinfo): ${_ip}"
        if [ -n "${_resolved}" ]; then
            out_info "DNS lookup (A):    ${_resolved}"
        else
            out_warn "DNS lookup (A):    (no A record from resolver)"
        fi
        out_info "Cloudflare API A:  ${_cur}"
        if [ "${_sync}" = "true" ]; then
            out_success "in_sync: public IP matches DNS lookup"
        else
            out_warn "in_sync: public IP does not match DNS lookup"
        fi
        out_info "ttl: ${_ttl} proxied: ${_px} id: ${_rid}"
    fi
}

