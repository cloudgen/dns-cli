    fi
    python3 -c '
import json,sys
with open(sys.argv[1], encoding="utf-8") as fh:
    data=json.load(fh)
for rec in data.get("result") or []:
    print(rec.get("id",""))
' "${CF_DNS_JSON}" | while IFS= read -r _rid; do
