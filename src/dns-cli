cf_dns_collapse() {
    _keep_ip="$1"
    _keep_id=""
    python3 -c '
import json,sys
path, keep_ip = sys.argv[1], sys.argv[2]
with open(path, encoding="utf-8") as fh:
    data=json.load(fh)
ids=[]
keep=""
for rec in data.get("result") or []:
    rid=rec.get("id","")
    if rec.get("content")==keep_ip and not keep:
        keep=rid
    else:
        ids.append(rid)
if not keep and ids:
    keep=ids.pop(0)
print(keep)
print("\n".join(ids))
' "${CF_DNS_JSON}" "${_keep_ip}" >"${CFV_DIR}/.collapse"
    _keep_id=$(sed -n '1p' "${CFV_DIR}/.collapse")
    _rest=$(sed -n '2,$p' "${CFV_DIR}/.collapse")
    rm -f "${CFV_DIR}/.collapse"
    while IFS= read -r _rid || [ -n "${_rid}" ]; do
        [ -z "${_rid}" ] && continue
        cf_api_curl DELETE "https://api.cloudflare.com/client/v4/zones/${CFV_ZONE_ID}/dns_records/${_rid}"
        rm -f "${CF_API_BODY}"
    done <<EOF
${_rest}
EOF
    CF_KEEP_ID="${_keep_id}"
}

cf_dns_payload() {
    _name="$1"
    _ip="$2"
    : "${CF_OPT_TTL:=300}"
    : "${CF_OPT_PROXIED:=false}"
    printf '{"type":"A","name":"%s","content":"%s","ttl":%s,"proxied":%s}' \
        "${_name}" "${_ip}" "${CF_OPT_TTL}" "${CF_OPT_PROXIED}"
}

# Create then delete _test_{UTC timestamp} to prove the zone token can write DNS.
# MUST NOT persist the probe label in the vault. Documentation IPv4 only.
cf_vault_token_probe() {
    CF_PROBE_LABEL=$(date -u +'_test_%Y%m%d%H%M%S')
    if [ -z "${CFV_TOKEN}" ] || [ -z "${CFV_ZONE_ID}" ] || [ -z "${CFV_DOMAIN}" ]; then
        return 1
    fi
    if ! cf_json_have_tool; then
        return 1
    fi
    cf_vault_dir
    cf_vault_ensure_dir0700 "${CFV_DIR}"
    _fqdn=$(cf_derive_fqdn "${CF_PROBE_LABEL}" "${CFV_DOMAIN}")
    cf_api_curl POST \
        "https://api.cloudflare.com/client/v4/zones/${CFV_ZONE_ID}/dns_records" \
        "$(cf_dns_payload "${_fqdn}" "203.0.113.10")"
    if [ "${CF_API_HTTP}" != "200" ]; then
        rm -f "${CF_API_BODY:-}"
        return 1
    fi
    _ok=$(cf_json_get "${CF_API_BODY}" "success" 2>/dev/null || echo "false")
    _rid=$(cf_json_get "${CF_API_BODY}" "result.id" 2>/dev/null || echo "")
    rm -f "${CF_API_BODY:-}"
    if [ "${_ok}" != "true" ] || [ -z "${_rid}" ]; then
        return 1
    fi
    cf_api_curl DELETE \
        "https://api.cloudflare.com/client/v4/zones/${CFV_ZONE_ID}/dns_records/${_rid}"
    _del="${CF_API_HTTP}"
    rm -f "${CF_API_BODY:-}"
    if [ "${_del}" != "200" ]; then
        return 1
    fi
    return 0
}

cf_vault_require_token_probe() {
    if ! cf_vault_token_probe; then
        out_die_code token_probe_failed \
            "API token failed probe ${CF_PROBE_LABEL:-_test_*} create/delete"
    fi
}

# ALIGNMENT: requirement-dns-approver.md (APR-M3..M4)
# Heal .bashrc hook + create .profile (if missing) when interactive approver.
cf_approver_user() {
    printf '%s' "${CF_APPROVER_USER:-dns-adm}"
}

cf_approver_hook_block() {
    printf '%s\n' \
        "# BEGIN dns-cli login hook" \
        "if [ -z \"\${DNS_CLI_HOOK_RAN:-}\" ] \\" \
        "    && [ -n \"\${PS1:-}\" ] \\" \
        "    && [ -t 0 ] && [ -t 1 ] \\" \
        "    && case \"\$-\" in *i*) true ;; *) false ;; esac \\" \
        "    && [ \"\$(id -un)\" = \"$(cf_approver_user)\" ] \\" \
        "    && [ -z \"\${SSH_ORIGINAL_COMMAND:-}\" ]; then" \
        "    DNS_CLI_HOOK_RAN=1" \
        "    export DNS_CLI_HOOK_RAN" \
        "    if ! sudo -n ${GLOBAL_BIN:-/usr/local/bin}/${APP_NAME:-dns-cli} interactive; then" \
        "        printf '%s\\n' \"dns-cli: login review hook skipped (sudo -n failed)\" >&2" \
        "    fi" \
        "fi" \
        "# END dns-cli login hook"
}

cf_approver_profile_block() {
    printf '%s\n' \
        "# BEGIN dns-cli profile source-bashrc" \
        "# Created so a bash login shell sources interactive rc (hook lives in .bashrc)." \
        "if [ -n \"\${BASH_VERSION:-}\" ]; then" \
        "    if [ -f \"\${HOME}/.bashrc\" ]; then" \
        "        . \"\${HOME}/.bashrc\"" \
        "    fi" \
        "fi" \
        "# END dns-cli profile source-bashrc"
}

cf_approver_heal_login_rc() {
    : "${JSON:=0}"
    : "${TTY:=0}"
    if [ "${JSON}" -eq 1 ]; then
        return 0
    fi
    if [ "${TTY}" -ne 1 ] && [ "${CF_TEST_HEAL_RC:-0}" != "1" ]; then
        return 0
    fi
    if [ "$(id -un 2>/dev/null || echo "")" != "$(cf_approver_user)" ]; then
        return 0
    fi
    _home="${HOME-}"
    case "${_home}" in
        ""|/tmp|/tmp/*|/dev/shm|/dev/shm/*)
            return 0
            ;;
    esac
    if [ ! -d "${_home}" ]; then
        return 0
    fi
    _brc="${_home}/.bashrc"
    _prf="${_home}/.profile"
    _has_begin=0
    _has_end=0
    if [ -f "${_brc}" ]; then
        grep -q '# BEGIN dns-cli login hook' "${_brc}" 2>/dev/null && _has_begin=1
        grep -q '# END dns-cli login hook' "${_brc}" 2>/dev/null && _has_end=1
    fi
    if [ "${_has_begin}" -ne 1 ] || [ "${_has_end}" -ne 1 ]; then
        _tmp=$(mktemp "${_home}/.bashrc.dns-cli.XXXXXX") || return 0
        if [ -f "${_brc}" ]; then
            cp -p "${_brc}" "${_tmp}" || { rm -f "${_tmp}"; return 0; }
            cf_approver_hook_block >>"${_tmp}" || { rm -f "${_tmp}"; return 0; }
        else
            cf_approver_hook_block >"${_tmp}" || { rm -f "${_tmp}"; return 0; }
            chmod 0600 "${_tmp}" 2>/dev/null || true
        fi
        mv -f "${_tmp}" "${_brc}" || { rm -f "${_tmp}"; return 0; }
    fi
    if [ ! -f "${_prf}" ]; then
        _ptmp=$(mktemp "${_home}/.profile.dns-cli.XXXXXX") || return 0
        cf_approver_profile_block >"${_ptmp}" || { rm -f "${_ptmp}"; return 0; }
        chmod 0600 "${_ptmp}" 2>/dev/null || true
        if [ ! -f "${_prf}" ]; then
            mv -f "${_ptmp}" "${_prf}" || { rm -f "${_ptmp}"; return 0; }
        else
            rm -f "${_ptmp}"
        fi
    fi
    if [ -f "${_brc}" ]; then
        util_align_rc_owner "${_brc}" "$(cf_approver_user)"
    fi
    if [ -f "${_prf}" ]; then
        util_align_rc_owner "${_prf}" "$(cf_approver_user)"
    fi
}

# =============================================================================
# lpu_* — Type 1 setup / remove-lpu and Type 0 print-sudoers
# =============================================================================
#
# GENERAL PURPOSE:
# Create and remove Linux user dns-adm (F3 home, F5 vault dir, F6 sudoers dest)
# and emit the Table A fragment. Host useradd is Table C (not sudoers).
#
# ALIGNMENT:
# - requirement-least-privilege-user.md
# - requirement-three-layer-privilege-model.md
# - requirement-dns-approver.md
# - requirement-shell-cli-interface.md
#
# Last reviewed: 2026-08-18
# =============================================================================

lpu_user() {
    printf '%s' "${CF_LPU_USER:-${CF_APPROVER_USER:-dns-adm}}"
}

lpu_test_mode() {
    : "${CF_TEST_LPU:=0}"
    if [ "${CF_TEST_LPU}" = "1" ]; then
        return 0
    fi
    return 1
}

lpu_etc_prefix() {
    if [ -n "${CF_LPU_ROOT:-}" ]; then
        printf '%s/etc' "${CF_LPU_ROOT}"
        return 0
    fi
    printf '%s' "/etc"
}

lpu_home_preferred() {
    printf '%s/%s' "$(lpu_etc_prefix)" "$(lpu_user)"
}

lpu_home_fallback() {
    if [ -n "${CF_LPU_ROOT:-}" ]; then
        printf '%s/home/%s' "${CF_LPU_ROOT}" "$(lpu_user)"
        return 0
    fi
    printf '/home/%s' "$(lpu_user)"
}

lpu_sudoers_dest() {
    if [ -n "${CF_LPU_SUDOERS:-}" ]; then
        printf '%s' "${CF_LPU_SUDOERS}"
        return 0
    fi
    printf '%s/%s/sudoers' "$(lpu_etc_prefix)" "$(lpu_user)"
}

lpu_backup_dir() {
    if [ -n "${CF_SUDOER_BACKUP:-}" ]; then
        printf '%s' "${CF_SUDOER_BACKUP}"
        return 0
    fi
    printf '%s/sudoer-backup' "$(lpu_etc_prefix)"
}

lpu_passwd_file() {
    if [ -n "${CF_LPU_PASSWD:-}" ]; then
        printf '%s' "${CF_LPU_PASSWD}"
        return 0
    fi
    if [ -n "${CF_LPU_ROOT:-}" ]; then
        printf '%s/passwd' "${CF_LPU_ROOT}"
        return 0
    fi
    printf '%s' ""
}

lpu_account_present() {
    _u=$(lpu_user)
    if lpu_test_mode; then
        _pw=$(lpu_passwd_file)
        if [ -n "${_pw}" ] && [ -f "${_pw}" ]; then
            grep -q "^${_u}:" "${_pw}" 2>/dev/null
            return $?
        fi
        return 1
    fi
    if command -v getent >/dev/null 2>&1; then
        if getent passwd "${_u}" >/dev/null 2>&1; then
            return 0
        fi
        return 1
    fi
    id "${_u}" >/dev/null 2>&1
}

# Live F3 home from passwd (stub or host). Empty = fail.
lpu_live_home() {
    _u=$(lpu_user)
    _line=""
    if lpu_test_mode; then
        _pw=$(lpu_passwd_file)
        if [ -n "${_pw}" ] && [ -f "${_pw}" ]; then
            _line=$(grep "^${_u}:" "${_pw}" 2>/dev/null || true)
        fi
    elif command -v getent >/dev/null 2>&1; then
        _line=$(getent passwd "${_u}" 2>/dev/null || true)
    fi
    if [ -z "${_line}" ]; then
        return 1
    fi
    _home=$(printf '%s\n' "${_line}" | cut -d: -f6)
    if [ -z "${_home}" ]; then
        return 1
    fi
    printf '%s' "${_home}"
    return 0
}

# Type-2 dest: {{SYSTEM_USER_HOME}}/.local/vaults/{{APP_NAME}}
lpu_default_vault_dir() {
    : "${APP_NAME:=dns-cli}"
    _home=$(lpu_live_home) || return 1
    printf '%s/.local/vaults/%s' "${_home}" "${APP_NAME}"
    return 0
}

lpu_invoker_is_lpu() {
    _me=$(id -un 2>/dev/null || echo "unknown")
    _lpu=$(lpu_user)
    if [ "${_me}" = "${_lpu}" ]; then
        return 0
    fi
    return 1
}

lpu_type2_command() {
    case "${1:-}" in
        vault|add|update|remove|status|show)
            return 0
            ;;
    esac
    return 1
}

lpu_type2_save_argv() {
    TYPE2_ARGC=0
    for _t2a in "$@"; do
        TYPE2_ARGC=$((TYPE2_ARGC + 1))
        eval "TYPE2_ARGV_${TYPE2_ARGC}=\"\${_t2a}\""
    done
}

lpu_type2_die_required() {
    : "${APP_NAME:=dns-cli}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    _lpu=$(lpu_user)
    _who=$(id -un 2>/dev/null || echo "unknown")
    _gbin="${GLOBAL_BIN}/${APP_NAME}"
    if [ ! -x "${_gbin}" ]; then
        out_die_code lpu_required "Default vault work must run as ${_lpu}. You are ${_who}. Global CLI is missing at ${_gbin}. Next: sudo ${APP_NAME} install"
    fi
    out_die_code lpu_required "Default vault work must run as ${_lpu}. You are ${_who}. sudo -n -u ${_lpu} ${_gbin} is not available. Next: ${APP_NAME} generate-sudoer-request then ${APP_NAME} submit-sudoer-request  (or --vault-dir for QA)"
}

# P-M4 / L-M2: unspecified vault/DNS as a non-dns-adm login must
# sudo -n -u dns-adm the managed global binary, or fail lpu_required.
# Specify (--vault-dir / CF_VAULT_DIR) stays Type 0 and does not switch.
lpu_type2_maybe_reexec() {
    : "${APP_NAME:=dns-cli}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${COMMAND:=}"
    : "${DNS_CLI_TYPE2:=0}"
    if ! lpu_type2_command "${COMMAND}"; then
        return 0
    fi
    if cf_vault_specified_root >/dev/null; then
        return 0
    fi
    if lpu_invoker_is_lpu; then
        return 0
    fi
    if ! lpu_account_present; then
        out_die_code lpu_missing "dns-adm is not on this host. Next: sudo ${APP_NAME} setup  (or --vault-dir for QA)"
    fi
    if [ "${DNS_CLI_TYPE2}" = "1" ]; then
        lpu_type2_die_required
    fi
    if lpu_test_mode; then
        lpu_type2_die_required
    fi
    _lpu=$(lpu_user)
    _gbin="${GLOBAL_BIN}/${APP_NAME}"
    if [ ! -x "${_gbin}" ]; then
        lpu_type2_die_required
    fi
    if ! sudo -n -u "${_lpu}" -- "${_gbin}" version >/dev/null 2>&1; then
        lpu_type2_die_required
    fi
    DNS_CLI_TYPE2=1
    export DNS_CLI_TYPE2
    : "${TYPE2_ARGC:=0}"
    _i=1
    set --
    while [ "${_i}" -le "${TYPE2_ARGC}" ]; do
        eval "set -- \"\$@\" \"\$TYPE2_ARGV_${_i}\""
        _i=$((_i + 1))
    done
    exec sudo -n -u "${_lpu}" -- "${_gbin}" "$@"
    lpu_type2_die_required
}

lpu_owner_name() {
    _p="$1"
    if [ ! -e "${_p}" ]; then
        printf '%s' ""
        return 0
    fi
    if stat -c '%U' "${_p}" >/dev/null 2>&1; then
        stat -c '%U' "${_p}"
        return 0
    fi
    if stat -f '%Su' "${_p}" >/dev/null 2>&1; then
        stat -f '%Su' "${_p}"
        return 0
    fi
    printf '%s' ""
}

lpu_resolve_home() {
    : "${CF_OPT_HOME:=}"
    _u=$(lpu_user)
    if [ -n "${CF_OPT_HOME}" ]; then
        case "${CF_OPT_HOME}" in
            /*)
                LPU_HOME="${CF_OPT_HOME}"
                LPU_HOME_REASON="override"
                return 0
                ;;
            *)
                out_die_code vault_insecure "setup --home must be an absolute path"
                ;;
        esac
    fi
    _pref=$(lpu_home_preferred)
    if [ ! -e "${_pref}" ]; then
        LPU_HOME="${_pref}"
        LPU_HOME_REASON="preferred-/etc"
        return 0
    fi
    _own=$(lpu_owner_name "${_pref}")
    if [ "${_own}" = "${_u}" ] || [ "${_own}" = "root" ] || [ -z "${_own}" ]; then
        LPU_HOME="${_pref}"
        LPU_HOME_REASON="preferred-/etc"
        return 0
    fi
    if lpu_test_mode; then
        LPU_HOME="${_pref}"
        LPU_HOME_REASON="preferred-/etc"
        return 0
    fi
    LPU_HOME=$(lpu_home_fallback)
    LPU_HOME_REASON="fallback-/home"
}

lpu_require_elev() {
    _verb="$1"
    : "${APP_NAME:=dns-cli}"
    : "${JSON:=0}"
    : "${TTY:=0}"
    : "${FORCE:=0}"
    : "${CF_OPT_HOME:=}"
    if lpu_test_mode; then
        return 0
    fi
    if [ "$(id -u 2>/dev/null || echo 1)" -eq 0 ]; then
        return 0
    fi
    _who=$(id -un 2>/dev/null || echo "unknown")
    _msg="${_verb} must run as root. You are ${_who} (not root). Next: sudo ${APP_NAME} ${_verb}"
    if [ "${JSON}" -eq 1 ] || [ "${TTY}" -ne 1 ]; then
        out_die_code lpu_required "${_msg}"
    fi
    _src=$(util_resolve_running_path)
    if [ -z "${_src}" ] || [ ! -f "${_src}" ]; then
        out_die_code lpu_required "${_msg}"
    fi
    out_info "Re-running ${_verb} with sudo (password prompt)."
    if [ "${FORCE}" -eq 1 ]; then
        if [ -n "${CF_OPT_HOME}" ]; then
            exec sudo -p "[sudo] password for %p: " "${_src}" "${_verb}" --force --home "${CF_OPT_HOME}"
        fi
        exec sudo -p "[sudo] password for %p: " "${_src}" "${_verb}" --force
    fi
    if [ -n "${CF_OPT_HOME}" ]; then
        exec sudo -p "[sudo] password for %p: " "${_src}" "${_verb}" --home "${CF_OPT_HOME}"
    fi
    exec sudo -p "[sudo] password for %p: " "${_src}" "${_verb}"
}

lpu_stub_useradd() {
    _u=$(lpu_user)
    _home="$1"
    _pw=$(lpu_passwd_file)
    if [ -z "${_pw}" ]; then
        out_die_code lpu_exists "Test setup needs CF_LPU_ROOT or CF_LPU_PASSWD"
    fi
    _pdir=$(dirname "${_pw}")
    if [ ! -d "${_pdir}" ]; then
        mkdir -p "${_pdir}" || out_die_code vault_insecure "Cannot create ${_pdir}"
    fi
    if [ -f "${_pw}" ]; then
        if grep -q "^${_u}:" "${_pw}" 2>/dev/null; then
            return 0
        fi
    fi
    printf '%s:x:1701:1701:dns-cli LPU:%s:/bin/bash\n' "${_u}" "${_home}" >>"${_pw}"
}

lpu_host_useradd() {
    _u=$(lpu_user)
    _home="$1"
    if command -v getent >/dev/null 2>&1; then
        if ! getent group "${_u}" >/dev/null 2>&1; then
            if ! groupadd "${_u}"; then
                out_die_code lpu_exists "Could not create group ${_u}."
            fi
        fi
    else
        if ! groupadd "${_u}" 2>/dev/null; then
            :
        fi
    fi
    if lpu_account_present; then
        return 0
    fi
    if ! useradd -d "${_home}" -s /bin/bash -g "${_u}" -c "dns-cli least-privilege user" "${_u}"; then
        out_die_code lpu_exists "Could not create Linux user ${_u} (name or id already used). Next: getent passwd ${_u}"
    fi
    if command -v passwd >/dev/null 2>&1; then
        passwd -l "${_u}" >/dev/null 2>&1 || true
    fi
}

lpu_ensure_account() {
    _home="$1"
    if lpu_test_mode; then
        lpu_stub_useradd "${_home}"
        return 0
    fi
    lpu_host_useradd "${_home}"
}

lpu_chown_tree() {
    _path="$1"
    _u=$(lpu_user)
    if lpu_test_mode; then
        return 0
    fi
    if [ ! -e "${_path}" ]; then
        return 0
    fi
    chown "${_u}:${_u}" "${_path}" || out_die_code lpu_exists "Cannot chown ${_path} to ${_u}"
}

lpu_fragment() {
    : "${APP_NAME:=dns-cli}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    _u=$(lpu_user)
    _bin="${GLOBAL_BIN}/${APP_NAME}"
    _dest=$(lpu_sudoers_dest)
    printf '%s\n' \
        "# dns-cli — run managed CLI as ${_u} (review before install)" \
        "# Generated: dns-cli print-sudoers" \
        "# Dest: ${_dest}" \
        "# Admin: visudo -c -f DEST && install -m 0440 DEST ${_dest}" \
        "# Trust: production only when ${_bin} is the managed binary" \
        "" \
        "%sudo ALL=(${_u}) NOPASSWD: ${_bin}" \
        ""
}

lpu_backup_f6() {
    _dest=$(lpu_sudoers_dest)
    if [ ! -f "${_dest}" ]; then
        return 0
    fi
    _bdir=$(lpu_backup_dir)
    case "${_bdir}" in
        */sudoers.d|*/sudoers.d/*)
            out_die_code vault_insecure "F6 backup must not land under /etc/sudoers.d"
            ;;
    esac
    if [ ! -d "${_bdir}" ]; then
        mkdir -p "${_bdir}" || out_die_code vault_insecure "Cannot create ${_bdir}"
    fi
    _stamp=$(date -u +'%Y%m%dT%H%M%SZ')
    _n=0
    _bak="${_bdir}/$(lpu_user).sudoers.${_stamp}"
    while [ -e "${_bak}" ]; do
        _n=$((_n + 1))
        _bak="${_bdir}/$(lpu_user).sudoers.${_stamp}.${_n}"
    done
    if ! cp "${_dest}" "${_bak}"; then
        out_die_code vault_insecure "Cannot backup sudoers dest to ${_bak}"
    fi
    chmod 0440 "${_bak}" 2>/dev/null || true
}

lpu_install_sudoers() {
    : "${APP_NAME:=dns-cli}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${FORCE:=0}"
    _gbin="${GLOBAL_BIN}/${APP_NAME}"
    if [ ! -x "${_gbin}" ]; then
        if [ "${FORCE}" -ne 1 ]; then
            out_die_code lpu_required "setup writes sudoers only when the global CLI exists at ${_gbin}. This host has no global install. Next: sudo ${APP_NAME} install   or: sudo ${APP_NAME} setup --force"
        fi
        out_warn "TEST MODE: no global ${_gbin}; installing sudoers dest anyway (--force)."
    fi
    _dest=$(lpu_sudoers_dest)
    _ddir=$(dirname "${_dest}")
    if [ ! -d "${_ddir}" ]; then
        mkdir -p "${_ddir}" || out_die_code vault_insecure "Cannot create ${_ddir}"
    fi
    _tmp=$(mktemp "${_ddir}/.sudoers.XXXXXX") || out_die_code vault_insecure "mktemp failed for sudoers dest"
    if ! lpu_fragment >"${_tmp}"; then
        rm -f "${_tmp}"
        out_die_code vault_insecure "Cannot write sudoers draft"
    fi
    if ! lpu_test_mode; then
        if command -v visudo >/dev/null 2>&1; then
            if ! visudo -c -f "${_tmp}" >/dev/null 2>&1; then
                rm -f "${_tmp}"
                out_die_code vault_insecure "visudo rejected the generated sudoers draft"
            fi
        fi
    fi
    lpu_backup_f6
    if command -v install >/dev/null 2>&1; then
        if ! install -m 0440 "${_tmp}" "${_dest}"; then
            rm -f "${_tmp}"
            out_die_code vault_insecure "Cannot install sudoers dest ${_dest}"
        fi
    else
        if ! cp -f "${_tmp}" "${_dest}"; then
            rm -f "${_tmp}"
            out_die_code vault_insecure "Cannot copy sudoers dest ${_dest}"
        fi
        chmod 0440 "${_dest}" || true
    fi
    rm -f "${_tmp}"
    if ! lpu_test_mode; then
        chown root:root "${_dest}" 2>/dev/null || true
    fi
}

lpu_heal_home_rc() {
    _home="$1"
    case "${_home}" in
        ""|/tmp|/tmp/*|/dev/shm|/dev/shm/*)
            return 0
            ;;
    esac
    if [ ! -d "${_home}" ]; then
        return 0
    fi
    _brc="${_home}/.bashrc"
    _prf="${_home}/.profile"
    _has_begin=0
    _has_end=0
    if [ -f "${_brc}" ]; then
        grep -q '# BEGIN dns-cli login hook' "${_brc}" 2>/dev/null && _has_begin=1
        grep -q '# END dns-cli login hook' "${_brc}" 2>/dev/null && _has_end=1
    fi
    if [ "${_has_begin}" -ne 1 ] || [ "${_has_end}" -ne 1 ]; then
        _tmp=$(mktemp "${_home}/.bashrc.dns-cli.XXXXXX") || return 0
        if [ -f "${_brc}" ]; then
            if ! cp -p "${_brc}" "${_tmp}"; then
                rm -f "${_tmp}"
                return 0
            fi
            if ! cf_approver_hook_block >>"${_tmp}"; then
                rm -f "${_tmp}"
                return 0
            fi
        else
            if ! cf_approver_hook_block >"${_tmp}"; then
                rm -f "${_tmp}"
                return 0
            fi
            chmod 0600 "${_tmp}" 2>/dev/null || true
        fi
        if ! mv -f "${_tmp}" "${_brc}"; then
            rm -f "${_tmp}"
            return 0
        fi
    fi
    if [ ! -f "${_prf}" ]; then
        _ptmp=$(mktemp "${_home}/.profile.dns-cli.XXXXXX") || return 0
        if ! cf_approver_profile_block >"${_ptmp}"; then
            rm -f "${_ptmp}"
            return 0
        fi
        chmod 0600 "${_ptmp}" 2>/dev/null || true
        if [ ! -f "${_prf}" ]; then
            if ! mv -f "${_ptmp}" "${_prf}"; then
                rm -f "${_ptmp}"
                return 0
            fi
        else
            rm -f "${_ptmp}"
        fi
    fi
    util_align_rc_owner "${_brc}" "$(lpu_user)" 1
    if [ -f "${_prf}" ]; then
        util_align_rc_owner "${_prf}" "$(lpu_user)" 1
    fi
}

lpu_print_sudoers() {
    : "${APP_NAME:=dns-cli}"
    : "${JSON:=0}"
    _dest=$(lpu_sudoers_dest)
    _outpath="${CF_POS2:-}"
    if [ -n "${_outpath}" ]; then
        case "${_outpath}" in
            /*) ;;
            *)
                out_die_code vault_insecure "print-sudoers path must be absolute"
                ;;
        esac
        if [ "${_outpath}" = "${_dest}" ]; then
            out_die_code vault_insecure "print-sudoers does not write the installed dest ${_dest}. Next: sudo ${APP_NAME} setup"
        fi
        lpu_fragment >"${_outpath}" || out_die_code vault_insecure "Cannot write ${_outpath}"
    fi
    _frag=$(lpu_fragment)
    if [ "${JSON}" -eq 1 ]; then
        out_json "print-sudoers" "Table A fragment (dest not written)" \
            "dest" "${_dest}" \
            "wrote_path" "${_outpath}" \
            "fragment" "${_frag}"
        return 0
    fi
    out_plain "${_frag}"
    out_plain ""
    out_info "This printed a draft only. It did not install ${_dest}."
    out_info "Admin: visudo -c -f DRAFT && install -m 0440 DRAFT ${_dest}"
    out_info "Or: sudo ${APP_NAME} setup"
    out_info "JSON grant (sibling submit): ${APP_NAME} generate-sudoer-request"
}

# =============================================================================
# lpu_* sudoer-approval-submitter (JSON grant → sibling sudoer-cli)
# ALIGNMENT: requirement-sudoer-json-file.md
#             requirement-three-layer-privilege-model.md §P-M8 / P-M9
# =============================================================================

lpu_sudoers_normalize_kind() {
    _k="${1:-${SUDOER_REQUEST_KIND:-type-2-switch}}"
    case "${_k}" in
        type-2-switch|login-hook-elev) printf '%s' "${_k}" ;;
        *) out_die_code request_invalid "sudoer request kind must be type-2-switch or login-hook-elev (got ${_k})" ;;
    esac
}

lpu_sudoers_json_text_compact() {
    : "${APP_NAME:=dns-cli}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${SUBMIT_ACTION:=add}"
    _kind=$(lpu_sudoers_normalize_kind "${SUDOER_REQUEST_KIND:-type-2-switch}")
    _action="${SUBMIT_ACTION}"
    case "${_action}" in
        add|update) ;;
        *) _action="add" ;;
    esac
    _path="${GLOBAL_BIN}/${APP_NAME}"
    _lpu=$(lpu_user)
    if [ "${_kind}" = "login-hook-elev" ]; then
        _user="${_lpu}"
        _purpose="Allow ${_lpu} login hook to run ${APP_NAME} interactive via sudo -n."
        printf '%s\n' "{\"schema_version\":1,\"kind\":\"login-hook-elev\",\"purpose\":\"${_purpose}\",\"username\":\"${_user}\",\"service\":\"${APP_NAME}\",\"action\":\"${_action}\",\"commands\":[{\"runas\":\"root\",\"tags\":[\"NOPASSWD\"],\"path\":\"${_path}\",\"args\":[\"interactive\"]}]}"
        return 0
    fi
    _user=$(id -un 2>/dev/null || echo "unknown")
    _purpose="Allow ${_user} to run ${APP_NAME} as ${_lpu}."
    printf '%s\n' "{\"schema_version\":1,\"kind\":\"type-2-switch\",\"purpose\":\"${_purpose}\",\"username\":\"${_user}\",\"service\":\"${APP_NAME}\",\"action\":\"${_action}\",\"commands\":[{\"runas\":\"${_lpu}\",\"tags\":[\"NOPASSWD\"],\"path\":\"${_path}\",\"args\":[]}]}"
}

lpu_sudoers_trust_tier() {
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${APP_NAME:=dns-cli}"
    if [ -x "${GLOBAL_BIN}/${APP_NAME}" ] && [ ! -w "${GLOBAL_BIN}/${APP_NAME}" ]; then
        printf '%s' "production"
        return 0
    fi
    if [ -x "${GLOBAL_BIN}/${APP_NAME}" ]; then
        printf '%s' "test_local"
        return 0
    fi
    printf '%s' "unmanaged"
}

lpu_sudoers_require_emit_trust() {
    : "${APP_NAME:=dns-cli}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${ALLOW_TEST_LOCAL_SUDOERS:=0}"
    _cmd="${1:-generate-sudoer-request}"
    _tier=$(lpu_sudoers_trust_tier)
    if [ "${_tier}" != "production" ]; then
        if [ "${ALLOW_TEST_LOCAL_SUDOERS}" -ne 1 ]; then
            out_die_code sudoer_required "${_cmd} trust tier is ${_tier} (not production). Prefer: sudo ${APP_NAME} install  (global ${GLOBAL_BIN}/${APP_NAME}). To emit a test file: ${APP_NAME} ${_cmd} --allow-test-local"
        fi
    fi
}

lpu_sudoers_detect_kind_from_body() {
    _gb="${1:-}"
    case "${_gb}" in
        *'"kind":"login-hook-elev"'*|*'"kind": "login-hook-elev"'*)
            printf '%s' "login-hook-elev"
            return 0
            ;;
        *'"kind":"type-2-switch"'*|*'"kind": "type-2-switch"'*)
            printf '%s' "type-2-switch"
            return 0
            ;;
    esac
    case "${_gb}" in
        *'"runas":"root"'*|*'"runas": "root"'*)
            printf '%s' "unknown"
            return 0
            ;;
    esac
    printf '%s' "type-2-switch"
}

lpu_sudoers_refuse_forbidden_grant() {
    _gf="${1:-}"
    : "${APP_NAME:=dns-cli}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    if [ -z "${_gf}" ] || [ ! -f "${_gf}" ]; then
        out_die_code request_invalid "sudoer grant file missing"
    fi
    _gb=$(cat "${_gf}" 2>/dev/null || true)
    _kind=$(lpu_sudoers_detect_kind_from_body "${_gb}")
    case "${_gb}" in
        *"/usr/bin/mkdir"*|*"/bin/mkdir"*|*"/usr/bin/cp"*|*"/bin/cp"*|*"/usr/bin/tar"*|*"/bin/tar"*|*"/bin/rm "*|*"/usr/bin/rm "*|*"/usr/bin/install"*|*"/usr/bin/chmod"*|*"/bin/chmod"*)
            out_die_code request_invalid "refusing sudoer grant with OS-tool commands (need ${GLOBAL_BIN}/${APP_NAME} only)"
            ;;
    esac
    case "${_gb}" in
        *'"args":["setup"'*|*'"args": ["setup"'*|*'"args":["remove-lpu"'*|*'"args": ["remove-lpu"'*)
            out_die_code request_invalid "refusing sudoer grant of setup / remove-lpu"
            ;;
    esac
    if [ "${_kind}" = "unknown" ]; then
        out_die_code request_invalid "refusing sudoer grant: runas root without kind=login-hook-elev"
    fi
    if [ "${_kind}" = "type-2-switch" ]; then
        case "${_gb}" in
            *'"runas":"root"'*|*'"runas": "root"'*)
                out_die_code request_invalid "refusing type-2-switch grant with runas root (need runas dns-adm)"
                ;;
        esac
    fi
    if [ "${_kind}" = "login-hook-elev" ]; then
        case "${_gb}" in
            *'"runas":"root"'*|*'"runas": "root"'*) ;;
            *) out_die_code request_invalid "refusing login-hook-elev grant without runas root" ;;
        esac
        case "${_gb}" in
            *'"args":[]'*|*'"args": []'*)
                out_die_code request_invalid "refusing login-hook-elev grant with empty args (need interactive only; whole CLI as root is forbidden)"
                ;;
        esac
        case "${_gb}" in
            *'"interactive"'*) ;;
            *) out_die_code request_invalid "refusing login-hook-elev grant: args must be interactive only" ;;
        esac
    fi
    return 0
}

lpu_sudoers_verify_grant() {
    _gf="${1:-}"
    : "${APP_NAME:=dns-cli}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    _lpu=$(lpu_user)
    if [ -z "${_gf}" ] || [ ! -f "${_gf}" ]; then
        out_die_code request_invalid "sudoer file missing"
    fi
    _gb=$(cat "${_gf}" 2>/dev/null || true)
    _kind=$(lpu_sudoers_detect_kind_from_body "${_gb}")
    case "${_gb}" in
        *'"service":"dns-cli"'*|*'"service": "dns-cli"'*) ;;
        *) out_die_code request_invalid "Sudoer file is incomplete: service is not dns-cli. Path: ${_gf}" ;;
    esac
    case "${_gb}" in
        *"${GLOBAL_BIN}/${APP_NAME}"*) ;;
        *) out_die_code request_invalid "Sudoer file is incomplete: path is not ${GLOBAL_BIN}/${APP_NAME}. Path: ${_gf}" ;;
    esac
    if [ "${_kind}" = "unknown" ]; then
        out_die_code request_invalid "Sudoer file is incomplete: unknown kind. Path: ${_gf}"
    fi
    if [ "${_kind}" = "login-hook-elev" ]; then
        case "${_gb}" in
            *'"runas":"root"'*|*'"runas": "root"'*) ;;
            *) out_die_code request_invalid "Sudoer file is incomplete: login-hook-elev runas is not root. Path: ${_gf}" ;;
        esac
        case "${_gb}" in
            *'"username":"'"${_lpu}"'"'*|*'"username": "'"${_lpu}"'"'*) ;;
            *) out_die_code request_invalid "Sudoer file is incomplete: login-hook-elev username is not ${_lpu}. Path: ${_gf}" ;;
        esac
        case "${_gb}" in
            *'"interactive"'*) ;;
            *) out_die_code request_invalid "Sudoer file is incomplete: login-hook-elev args must be interactive. Path: ${_gf}" ;;
        esac
        return 0
    fi
    case "${_gb}" in
        *'"runas":"'"${_lpu}"'"'*|*'"runas": "'"${_lpu}"'"'*) ;;
        *) out_die_code request_invalid "Sudoer file is incomplete: type-2-switch runas is not ${_lpu}. Path: ${_gf}" ;;
    esac
    return 0
}

lpu_detect_sudoer_cli() {
    : "${HOME:=/tmp}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${USER_BIN:=${HOME}/.local/bin}"
    : "${SUDOER_CLI:=}"
    if [ -n "${SUDOER_CLI}" ]; then
        if [ -x "${SUDOER_CLI}" ]; then
            printf '%s' "${SUDOER_CLI}"
            return 0
        fi
        return 1
    fi
    if [ -x "${GLOBAL_BIN}/sudoer-cli" ]; then
        printf '%s' "${GLOBAL_BIN}/sudoer-cli"
        return 0
    fi
    if [ -x "${USER_BIN}/sudoer-cli" ]; then
        printf '%s' "${USER_BIN}/sudoer-cli"
        return 0
    fi
    _found=$(command -v sudoer-cli 2>/dev/null || true)
    if [ -n "${_found}" ] && [ -x "${_found}" ]; then
        printf '%s' "${_found}"
        return 0
    fi
    return 1
}

lpu_detect_sudoer_adm() {
    : "${SUDOER_ADM_USER:=sudoer-adm}"
    if id "${SUDOER_ADM_USER}" >/dev/null 2>&1; then
        printf '%s' "${SUDOER_ADM_USER}"
        return 0
    fi
    return 1
}

lpu_detect_sudoer_inbound() {
    : "${SUDOER_ADM_USER:=sudoer-adm}"
    : "${SUDOER_QUEUE_INBOUND:=}"
    : "${SUDOER_APPROVAL_APP:=sudoer-cli}"
    : "${SUDOER_INBOUND_BASENAME:=sudoer-request}"
    : "${SUDOER_PUBLIC_ROOT:=/var/${SUDOER_APPROVAL_APP}}"
    if [ -n "${SUDOER_QUEUE_INBOUND}" ] && [ -d "${SUDOER_QUEUE_INBOUND}" ]; then
        printf '%s' "${SUDOER_QUEUE_INBOUND}"
        return 0
    fi
    _home=""
    if command -v getent >/dev/null 2>&1; then
        _home=$(getent passwd "${SUDOER_ADM_USER}" 2>/dev/null | cut -d: -f6)
    fi
    if [ -z "${_home}" ] && [ -r /etc/passwd ]; then
        _home=$(awk -F: -v u="${SUDOER_ADM_USER}" '$1==u {print $6; exit}' /etc/passwd 2>/dev/null)
    fi
    for _cand in \
        "${SUDOER_PUBLIC_ROOT}/${SUDOER_INBOUND_BASENAME}" \
        ${_home:+"${_home}/${SUDOER_INBOUND_BASENAME}"} \
        ${_home:+"${_home}/sudoer-approving"}
    do
        if [ -n "${_cand}" ] && [ -d "${_cand}" ]; then
            printf '%s' "${_cand}"
            return 0
        fi
    done
    return 1
}

lpu_alloc_inbound_request_id() {
    _in="${1:-}"
    _user="${2:-}"
    _svc="${3:-}"
    _act="${4:-}"
    [ -n "${_in}" ] && [ -d "${_in}" ] || return 1
    [ -n "${_user}" ] && [ -n "${_svc}" ] && [ -n "${_act}" ] || return 1
    _root=$(dirname -- "${_in}")
    _ad=$(date +%Y%m%d)
    _n=1
    while [ "${_n}" -le 999 ]; do
        _id="sudoer-${_ad}-${_svc}-${_user}-${_act}-${_n}.json"
        if [ ! -e "${_in}/${_id}" ] && \
           [ ! -e "${_root}/sudoer-approved/${_id}" ] && \
           [ ! -e "${_root}/sudoer-rejected/${_id}" ]; then
            printf '%s' "${_id}"
            return 0
        fi
        _n=$((_n + 1))
    done
    return 1
}

lpu_sudoer_queue_root_from_inbound() {
    _in="${1:-}"
    [ -n "${_in}" ] || return 1
    _base=$(basename -- "${_in}")
    if [ -n "${SUDOER_QUEUE_INBOUND}" ] && [ "${_in}" = "${SUDOER_QUEUE_INBOUND}" ]; then
        dirname -- "${_in}"
        return 0
    fi
    if [ "${_base}" = "${SUDOER_INBOUND_BASENAME:-sudoer-request}" ]; then
        _real="${_in}"
        if command -v readlink >/dev/null 2>&1; then
            _resolved=$(readlink -f "${_in}" 2>/dev/null || true)
            [ -n "${_resolved}" ] && _real="${_resolved}"
        fi
        dirname -- "${_real}"
        return 0
    fi
    return 1
}

lpu_probe_sibling_host_sudoers() {
    : "${APP_NAME:=dns-cli}"
    : "${SUDOERS_D_DIR:=/etc/sudoers.d}"
    _user="${1:-}"
    if [ -z "${_user}" ]; then
        _user=$(id -un 2>/dev/null || echo "unknown")
    fi
    _p="${SUDOERS_D_DIR}/${APP_NAME}-${_user}"
    if [ -f "${_p}" ]; then
        printf '%s' "${_p}"
        return 0
    fi
    return 1
}

lpu_default_sudoer_request_path() {
    : "${APP_NAME:=dns-cli}"
    : "${HOME:=/tmp}"
    _kind=$(lpu_sudoers_normalize_kind "${SUDOER_REQUEST_KIND:-type-2-switch}")
    if [ "${_kind}" = "login-hook-elev" ]; then
        _lpu=$(lpu_user)
        printf '%s' "${HOME}/.config/${APP_NAME}/sudoer-request-${_lpu}-login-hook.json"
        return 0
    fi
    _user=$(id -un 2>/dev/null || echo "unknown")
    printf '%s' "${HOME}/.config/${APP_NAME}/sudoer-request-${_user}.json"
}

lpu_sudoers_verify_sibling_convert() {
    _gf="${1:-}"
    : "${APP_NAME:=dns-cli}"
    _cli=""
    if _cli=$(lpu_detect_sudoer_cli); then
        :
    else
        return 1
    fi
    _help=$("${_cli}" help 2>/dev/null || true)
    case "${_help}" in
        *json-to-sudoers*) ;;
        *) return 1 ;;
    esac
    _stor="${EFFECTIVE_STORAGE_DIR:-${TMPDIR:-/tmp}}"
    _outf=$(mktemp "${_stor}/.sudoer-conv.XXXXXX") || return 1
    _kind=$(lpu_sudoers_detect_kind_from_body "$(cat "${_gf}" 2>/dev/null || true)")
    if ! "${_cli}" json-to-sudoers --file "${_gf}" --out "${_outf}" >/dev/null 2>&1; then
        rm -f "${_outf}"
        if [ "${_kind}" = "login-hook-elev" ]; then
            return 1
        fi
        out_die_code request_invalid "sudoer-cli json-to-sudoers failed for ${_gf}. The file is not safe to submit."
    fi
    _txt=$(cat "${_outf}" 2>/dev/null || true)
    rm -f "${_outf}"
    if [ "${_kind}" = "login-hook-elev" ]; then
        case "${_txt}" in
            *"(root)"*) ;;
            *) return 1 ;;
        esac
        case "${_txt}" in
            *interactive*) ;;
            *) return 1 ;;
        esac
    else
        case "${_txt}" in
            *"(dns-adm)"*) ;;
            *) out_die_code request_invalid "sudoer-cli convert dropped runas dns-adm from ${_gf}. Do not submit this file." ;;
        esac
    fi
    case "${_txt}" in
        *"${APP_NAME}"*) ;;
        *) out_die_code request_invalid "sudoer-cli convert dropped ${APP_NAME} from ${_gf}. Do not submit this file." ;;
    esac
    return 0
}

lpu_generate_sudoer_request() {
    : "${APP_NAME:=dns-cli}"
    : "${JSON:=0}"
    : "${HOME:=/tmp}"
    : "${SUBMIT_ACTION:=add}"
    : "${SUBMIT_ACTION_EXPLICIT:=0}"
    _out_path="${1:-}"
    SUDOER_REQUEST_KIND=$(lpu_sudoers_normalize_kind "${SUDOER_REQUEST_KIND:-type-2-switch}")
    export SUDOER_REQUEST_KIND
    _user=$(id -un 2>/dev/null || echo "unknown")
    _probe_user="${_user}"
    if [ "${SUDOER_REQUEST_KIND}" = "login-hook-elev" ]; then
        _probe_user=$(lpu_user)
    fi
    _host_present="false"
    if lpu_probe_sibling_host_sudoers "${_probe_user}" >/dev/null; then
        _host_present="true"
    fi
    if [ "${SUBMIT_ACTION_EXPLICIT}" -ne 1 ]; then
        if [ "${_host_present}" = "true" ]; then
            SUBMIT_ACTION="update"
        else
            SUBMIT_ACTION="add"
        fi
    fi
    case "${SUBMIT_ACTION}" in
        add|update) ;;
        *) out_die_code request_invalid "generate-sudoer-request action must be add or update (got ${SUBMIT_ACTION})" ;;
    esac
    lpu_sudoers_require_emit_trust "generate-sudoer-request"
    if [ -z "${_out_path}" ]; then
        _out_path=$(lpu_default_sudoer_request_path)
    fi
    case "${_out_path}" in
        /etc|/etc/*)
            out_die_code vault_insecure "generate-sudoer-request refuses to write under /etc (Type 0). Use a path under \$HOME or /dev/shm."
            ;;
        /var/sudoer-cli|/var/sudoer-cli/*)
            out_die_code vault_insecure "generate-sudoer-request does not write inbound. Write a local file, then: ${APP_NAME} submit-sudoer-request <path>"
            ;;
    esac
    if [ -e "${_out_path}" ] && [ -L "${_out_path}" ]; then
        out_die_code vault_insecure "refusing symlink dest: ${_out_path}"
    fi
    if [ -d "${_out_path}" ]; then
        out_die_code vault_insecure "generate dest is a directory: ${_out_path}"
    fi
    _dir=$(dirname -- "${_out_path}")
    if [ ! -d "${_dir}" ]; then
        mkdir -p "${_dir}" || out_die_code vault_insecure "Cannot create ${_dir}"
    fi
    lpu_sudoers_json_text_compact >"${_out_path}" || out_die_code vault_insecure "Cannot write ${_out_path}"
    chmod 0644 "${_out_path}" 2>/dev/null || true
    if [ ! -r "${_out_path}" ]; then
        out_die_code vault_insecure "generated sudoer file is not readable: ${_out_path}"
    fi
    lpu_sudoers_refuse_forbidden_grant "${_out_path}"
    lpu_sudoers_verify_grant "${_out_path}"
    _convert="skipped"
    if lpu_sudoers_verify_sibling_convert "${_out_path}"; then
        _convert="ok"
    fi
    if [ "${JSON}" -eq 1 ]; then
        out_json "generate-sudoer-request" "written" \
            "path" "${_out_path}" \
            "readable" "true" \
            "verified" "true" \
            "convert_checked" "$([ "${_convert}" = "ok" ] && echo true || echo false)" \
            "action" "${SUBMIT_ACTION}" \
            "kind" "${SUDOER_REQUEST_KIND}" \
            "host_fragment_present" "${_host_present}" \
            "user" "${_user}"
        return 0
    fi
    out_success "Wrote verified sudoer file to ${_out_path}"
    if [ "${SUDOER_REQUEST_KIND}" = "login-hook-elev" ]; then
        out_info "Grant kind=login-hook-elev: $(lpu_user) may sudo -n ${APP_NAME} interactive (action=${SUBMIT_ACTION})"
        out_info "Type 0 submit-sudoer-request will refuse this file. Setup auto-queues it when sibling sudoer-cli exists."
    else
        out_info "Grant kind=type-2-switch: ${_user} may run ${APP_NAME} as $(lpu_user) (action=${SUBMIT_ACTION})"
        out_info "Review the file, then submit it:"
        out_info "   ${APP_NAME} submit-sudoer-request ${_out_path}"
    fi
}

lpu_submit_sudoer_request() {
    : "${APP_NAME:=dns-cli}"
    : "${JSON:=0}"
    : "${HOME:=/tmp}"
    : "${SUDOER_ADM_USER:=sudoer-adm}"
    : "${SUBMIT_PURPOSE:=}"
    : "${SUBMIT_ACTION:=add}"
    : "${SUBMIT_ACTION_EXPLICIT:=0}"
    _src_file="${1:-}"
    _user=$(id -un 2>/dev/null || echo "unknown")
    _purpose="${SUBMIT_PURPOSE}"
    if [ -z "${_purpose}" ]; then
        _purpose="Allow ${_user} to run ${APP_NAME} as dns-adm."
    fi
    _host_path=""
    _host_present="false"
    if _host_path=$(lpu_probe_sibling_host_sudoers); then
        _host_present="true"
    else
        _host_path=""
    fi
    _action_source="explicit"
    if [ "${SUBMIT_ACTION_EXPLICIT}" -ne 1 ]; then
        _action_source="detected"
        if [ "${_host_present}" = "true" ]; then
            SUBMIT_ACTION="update"
        else
            SUBMIT_ACTION="add"
        fi
    fi
    case "${SUBMIT_ACTION}" in
        add|update) ;;
        *) out_die_code request_invalid "submit-sudoer-request action must be add or update (got ${SUBMIT_ACTION})" ;;
    esac
    if [ -n "${_src_file}" ]; then
        if [ ! -f "${_src_file}" ]; then
            out_die_code request_invalid "sudoers file not found: ${_src_file}"
        fi
        if [ -L "${_src_file}" ]; then
            out_die_code vault_insecure "refusing symlink sudoers input: ${_src_file}"
        fi
        lpu_sudoers_refuse_forbidden_grant "${_src_file}"
        _src_kind=$(lpu_sudoers_detect_kind_from_body "$(cat "${_src_file}" 2>/dev/null || true)")
        if [ "${_src_kind}" = "login-hook-elev" ]; then
            out_die_code request_invalid "submit-sudoer-request is Type 0 (current login, no sudo, type-2-switch only). login-hook-elev is Type 1 setup (password sudo). Dest Type 0 self-scope does not apply to setup."
        fi
        if [ "${_src_kind}" = "unknown" ]; then
            out_die_code request_invalid "submit-sudoer-request refused unknown sudoer kind"
        fi
    fi
    if [ "${SUDOER_REQUEST_KIND:-type-2-switch}" = "login-hook-elev" ]; then
        out_die_code request_invalid "submit-sudoer-request is Type 0 (current login, no sudo, type-2-switch only). login-hook-elev is Type 1 setup (password sudo). Dest Type 0 self-scope does not apply to setup."
    fi
    SUDOER_REQUEST_KIND="type-2-switch"
    export SUDOER_REQUEST_KIND
    _cli=""
    if _cli=$(lpu_detect_sudoer_cli); then
        :
    else
        out_die_code sudoer_required "sudoer-cli not found (set SUDOER_CLI or install sudoer-cli to ${GLOBAL_BIN:-/usr/local/bin}/sudoer-cli). Submit is Type 0 compose — this CLI does not write /etc. Next: sudo sudoer-cli setup"
    fi
    _adm=""
    if _adm=$(lpu_detect_sudoer_adm); then
        :
    else
        out_die_code sudoer_required "sudoer-adm not found (id ${SUDOER_ADM_USER} failed). Next: sudo sudoer-cli setup"
    fi
    : "${SUDOER_PUBLIC_ROOT:=/var/${SUDOER_APPROVAL_APP:-sudoer-cli}}"
    _inbound=""
    if _inbound=$(lpu_detect_sudoer_inbound); then
        :
    else
        out_die_code sudoer_required "sudoer inbound queue not found (preferred ${SUDOER_PUBLIC_ROOT}/sudoer-request). Next: sudo sudoer-cli setup"
    fi
    if [ ! -w "${_inbound}" ]; then
        out_die_code sudoer_required "sudoer inbound not writable: ${_inbound}. Check mode 3773 on public inbound (owner ${_adm})."
    fi
    _tmp=""
    _cleanup_tmp=0
    if [ -n "${_src_file}" ]; then
        _tmp="${_src_file}"
    else
        lpu_sudoers_require_emit_trust "submit-sudoer-request"
        _stor="${EFFECTIVE_STORAGE_DIR:-${TMPDIR:-/tmp}}"
        _tmp=$(mktemp "${_stor}/.sudoer.XXXXXX") || out_die_code vault_insecure "cannot write temp sudoer JSON"
        lpu_sudoers_json_text_compact >"${_tmp}" || out_die_code vault_insecure "cannot write temp sudoer JSON ${_tmp}"
        _cleanup_tmp=1
    fi
    lpu_sudoers_refuse_forbidden_grant "${_tmp}"
    lpu_sudoers_verify_grant "${_tmp}"
    lpu_sudoers_verify_sibling_convert "${_tmp}" || true
    if _qr=$(lpu_sudoer_queue_root_from_inbound "${_inbound}"); then
        SUDOER_CLI_QUEUE_ROOT="${_qr}"
        export SUDOER_CLI_QUEUE_ROOT
        if [ -n "${SUDOER_QUEUE_INBOUND}" ] && [ "${_inbound}" = "${SUDOER_QUEUE_INBOUND}" ]; then
            LPU_HOME="${_qr}"
            export LPU_HOME
        fi
    fi
    _verb="add-sudoer-request"
    if [ "${SUBMIT_ACTION}" = "update" ]; then
        _verb="update-sudoer-request"
    fi
    _stor="${EFFECTIVE_STORAGE_DIR:-${TMPDIR:-/tmp}}"
    _errf=$(mktemp "${_stor}/.sudoer-err.XXXXXX") || out_die_code vault_insecure "mktemp failed"
    _out=""
    _rc=0
    if [ "${JSON}" -eq 1 ]; then
        _out=$("${_cli}" --json "${_verb}" --file "${_tmp}" --purpose "${_purpose}" --service "${APP_NAME}" 2>"${_errf}")
        _rc=$?
    else
        _out=$("${_cli}" "${_verb}" --file "${_tmp}" --purpose "${_purpose}" --service "${APP_NAME}" 2>"${_errf}")
        _rc=$?
    fi
    _err=$(cat "${_errf}" 2>/dev/null || true)
    rm -f "${_errf}"
    if [ "${_cleanup_tmp}" -eq 1 ]; then
        rm -f "${_tmp}"
    fi
    if [ "${_rc}" -ne 0 ]; then
        if [ -n "${_err}" ]; then
            out_die_code sudoer_required "sudoer-cli ${_verb} failed: ${_err}"
        fi
        out_die_code sudoer_required "sudoer-cli ${_verb} failed (exit ${_rc})"
    fi
    _rid=$(printf '%s\n' "${_out}" | sed -n 's/.*"request_id":"\([^"]*\)".*/\1/p')
    if [ -z "${_rid}" ]; then
        _rid=$(printf '%s\n' "${_out}" | sed -n 's/.*request_id=\([^[:space:]]*\).*/\1/p')
    fi
    if [ -n "${_rid}" ] && [ -r "${_inbound}/${_rid}" ]; then
        lpu_sudoers_verify_grant "${_inbound}/${_rid}"
    fi
    if [ "${JSON}" -eq 1 ]; then
        out_json "submit-sudoer-request" "submitted" \
            "request_id" "${_rid}" \
            "action" "${SUBMIT_ACTION}" \
            "action_source" "${_action_source}" \
            "host_fragment_present" "${_host_present}" \
            "host_fragment_path" "${_host_path}" \
            "service" "${APP_NAME}" \
            "kind" "type-2-switch" \
            "user" "${_user}" \
            "sudoer_cli" "${_cli}" \
            "sudoer_adm" "${_adm}" \
            "inbound" "${_inbound}"
        return 0
    fi
    out_success "Submitted ${SUBMIT_ACTION} request via ${_cli}"
    if [ -n "${_rid}" ]; then
        out_info "request_id=${_rid}"
    fi
    out_info "inbound=${_inbound}  (approver: ${_adm})"
    out_info "This CLI did not write /etc. Approver must approve the request."
    return 0
}

lpu_submit_login_hook_sudoer_request() {
    : "${APP_NAME:=dns-cli}"
    : "${JSON:=0}"
    : "${SUDOER_ADM_USER:=sudoer-adm}"
    LOGIN_HOOK_SUDOER_STATUS="skipped"
    LOGIN_HOOK_SUDOER_REQUEST_ID=""
    _lpu=$(lpu_user)
    SUDOER_REQUEST_KIND="login-hook-elev"
    export SUDOER_REQUEST_KIND
    _cli=""
    if ! _cli=$(lpu_detect_sudoer_cli); then
        LOGIN_HOOK_SUDOER_STATUS="skipped"
        return 0
    fi
    _adm=""
    if ! _adm=$(lpu_detect_sudoer_adm); then
        LOGIN_HOOK_SUDOER_STATUS="skipped"
        return 0
    fi
    _inbound=""
    if ! _inbound=$(lpu_detect_sudoer_inbound); then
        LOGIN_HOOK_SUDOER_STATUS="skipped"
        return 0
    fi
    if [ ! -w "${_inbound}" ]; then
        LOGIN_HOOK_SUDOER_STATUS="skipped"
        return 0
    fi
    if [ "${SUBMIT_ACTION_EXPLICIT:-0}" -ne 1 ]; then
        if lpu_probe_sibling_host_sudoers "${_lpu}" >/dev/null; then
            SUBMIT_ACTION="update"
        else
            SUBMIT_ACTION="add"
        fi
    fi
    # Dest approval reviews the JSON in inbound. Dest Type 0 add-sudoer-request
    # compares username to id -un (self_scope). That is a blockage, not dest
    # approval. Type 1 setup writes inbound itself.
    _rid=$(lpu_alloc_inbound_request_id "${_inbound}" "${_lpu}" "${APP_NAME}" "${SUBMIT_ACTION}") || {
        LOGIN_HOOK_SUDOER_STATUS="failed"
        LOGIN_HOOK_SUDOER_ERROR="cannot allocate dest request_id under ${_inbound}"
        return 0
    }
    _stor="${EFFECTIVE_STORAGE_DIR:-${TMPDIR:-/tmp}}"
    _tmp=$(mktemp "${_stor}/.sudoer-hook.XXXXXX") || {
        LOGIN_HOOK_SUDOER_STATUS="failed"
        LOGIN_HOOK_SUDOER_ERROR="cannot create temp hook JSON"
        return 0
    }
    lpu_sudoers_json_text_compact >"${_tmp}" || {
        rm -f "${_tmp}"
        LOGIN_HOOK_SUDOER_STATUS="failed"
        LOGIN_HOOK_SUDOER_ERROR="cannot write temp hook JSON"
        return 0
    }
    lpu_sudoers_refuse_forbidden_grant "${_tmp}"
    lpu_sudoers_verify_grant "${_tmp}"
    _dest="${_inbound}/${_rid}"
    if ! mv "${_tmp}" "${_dest}"; then
        rm -f "${_tmp}"
        LOGIN_HOOK_SUDOER_STATUS="failed"
        LOGIN_HOOK_SUDOER_ERROR="cannot write ${_dest}"
        return 0
    fi
    chmod 0640 "${_dest}" 2>/dev/null || true
    # MUST NOT chown. Dest sudoer-adm takes ownership (sticky inbound).
    LOGIN_HOOK_SUDOER_STATUS="submitted"
    LOGIN_HOOK_SUDOER_REQUEST_ID="${_rid}"
    return 0
}

lpu_setup() {
    : "${APP_NAME:=dns-cli}"
    : "${JSON:=0}"
    : "${FORCE:=0}"
    lpu_require_elev "setup"
    lpu_resolve_home
    _u=$(lpu_user)
    _home="${LPU_HOME}"
    _reason="${LPU_HOME_REASON}"
    _existed=0
    if lpu_account_present; then
        _existed=1
    fi
    lpu_ensure_account "${_home}"
    if [ ! -d "${_home}" ]; then
        mkdir -p "${_home}" || out_die_code vault_insecure "Cannot create home ${_home}"
    fi
    chmod 0755 "${_home}" || true
    lpu_chown_tree "${_home}"
    _vaults="${_home}/.local/vaults"
    _vault="${_vaults}/${APP_NAME}"
    if [ ! -d "${_vaults}" ]; then
        mkdir -p "${_vaults}" || out_die_code vault_insecure "Cannot create vaults root ${_vaults}"
    fi
    chmod 0700 "${_vaults}" || out_die_code vault_insecure "Cannot chmod 0700 ${_vaults}"
    lpu_chown_tree "${_vaults}"
    if [ ! -d "${_vault}" ]; then
        mkdir -p "${_vault}" || out_die_code vault_insecure "Cannot create vault dir ${_vault}"
    fi
    chmod 0700 "${_vault}" || out_die_code vault_insecure "Cannot chmod 0700 ${_vault}"
    lpu_chown_tree "${_vault}"
    lpu_install_sudoers
    lpu_heal_home_rc "${_home}"
    cf_req_install_trio
    lpu_submit_login_hook_sudoer_request
    _dest=$(lpu_sudoers_dest)
    if [ "${JSON}" -eq 1 ]; then
        _st="healed"
        if [ "${_existed}" -eq 0 ]; then
            _st="created"
        fi
        if [ "${_existed}" -eq 0 ]; then
            _created="true"
        else
            _created="false"
        fi
        out_json "setup" "LPU ${_u} ready" \
            "user" "${_u}" \
            "home" "${_home}" \
            "home_reason" "${_reason}" \
            "vault_dir" "${_vault}" \
            "sudoers" "${_dest}" \
            "created" "${_created}" \
            "status" "${_st}" \
            "login_hook_sudoer" "${LOGIN_HOOK_SUDOER_STATUS}" \
            "login_hook_sudoer_request_id" "${LOGIN_HOOK_SUDOER_REQUEST_ID:-}"
        return 0
    fi
    if [ "${_existed}" -eq 1 ]; then
        out_success "Linux user ${_u} already exists (heal only)"
    else
        out_success "Created Linux user ${_u}"
    fi
    out_info "Home: ${_home} (${_reason})"
    out_info "Vault dir: ${_vault} (mode 0700)"
    out_info "Sudoers dest: ${_dest} (mode 0440)"
    case "${LOGIN_HOOK_SUDOER_STATUS}" in
        submitted)
            out_info "Queued login-hook-elev sudoer request (dns-adm sudo -n ${APP_NAME} interactive)"
            if [ -n "${LOGIN_HOOK_SUDOER_REQUEST_ID:-}" ]; then
                out_info "login_hook request_id=${LOGIN_HOOK_SUDOER_REQUEST_ID}"
            fi
            out_info "Type 1 setup (sudo) wrote inbound. Dest approval reviews the JSON (does not test who submitted)."
            ;;
        failed)
            if [ -n "${LOGIN_HOOK_SUDOER_ERROR:-}" ]; then
                out_warn "Could not write login-hook-elev JSON to inbound: ${LOGIN_HOOK_SUDOER_ERROR}"
            else
                out_warn "Could not write login-hook-elev JSON to inbound"
            fi
            ;;
        *)
            out_info "Login-hook sudoer request skipped (sudoer-cli / sudoer-adm / inbound not present). Next: sudo sudoer-cli setup"
            ;;
    esac
}

lpu_remove() {
    : "${APP_NAME:=dns-cli}"
    : "${JSON:=0}"
    : "${FORCE:=0}"
    : "${TTY:=0}"
    lpu_require_elev "remove-lpu"
    if [ "${FORCE}" -ne 1 ]; then
        if [ "${JSON}" -eq 1 ] || [ "${TTY}" -ne 1 ]; then
            out_die_code confirm_required "remove-lpu requires --force in non-interactive mode"
        fi
        if ! prompt_yes_no "Remove Linux user $(lpu_user) and home"; then
            out_die_code confirm_required "remove-lpu cancelled"
        fi
    fi
    _u=$(lpu_user)
    if ! lpu_account_present; then
        if [ "${JSON}" -eq 1 ]; then
            out_json "remove-lpu" "already absent" \
                "user" "${_u}" \
                "status" "already_absent"
            return 0
        fi
        out_success "Linux user ${_u} is not present (nothing to remove)"
        return 0
    fi
    lpu_backup_f6
    _dest=$(lpu_sudoers_dest)
    if [ -f "${_dest}" ]; then
        rm -f "${_dest}" || out_die_code vault_insecure "Cannot remove ${_dest}"
    fi
    if lpu_test_mode; then
        _pw=$(lpu_passwd_file)
        if [ -n "${_pw}" ] && [ -f "${_pw}" ]; then
            _tmp=$(mktemp "${_pw}.XXXXXX") || out_die_code vault_insecure "mktemp failed"
            grep -v "^${_u}:" "${_pw}" >"${_tmp}" || true
            mv -f "${_tmp}" "${_pw}"
        fi
        lpu_resolve_home
        if [ -n "${LPU_HOME:-}" ] && [ -d "${LPU_HOME}" ]; then
            rm -rf "${LPU_HOME}"
        fi
    else
        if ! userdel -r "${_u}"; then
            out_die_code lpu_exists "userdel -r ${_u} failed"
        fi
        if command -v groupdel >/dev/null 2>&1; then
            groupdel "${_u}" 2>/dev/null || true
        fi
    fi
    if [ "${JSON}" -eq 1 ]; then
        out_json "remove-lpu" "removed" \
            "user" "${_u}" \
            "status" "removed"
        return 0
    fi
    out_success "Removed Linux user ${_u}"
}

cf_dns_add() {
    cf_dns_ensure_ready
    cf_select_label
    _lab="${CF_SEL_LABEL}"
    _fqdn=$(cf_derive_fqdn "${_lab}" "${CFV_DOMAIN}")
    cf_ip_lookup
    _ip="${CF_PUBLIC_IP}"
    cf_zone_check
    cf_dns_list "${_fqdn}"
    _n="${CF_DNS_COUNT}"
    _st="created"
    : "${CF_SEL_MODE:=non-round-robin}"
    if [ "${CF_SEL_MODE}" = "round-robin" ]; then
        _hit=$(python3 -c '
import json,sys
path, ip = sys.argv[1], sys.argv[2]
with open(path, encoding="utf-8") as fh:
    data=json.load(fh)
for rec in data.get("result") or []:
    if rec.get("content")==ip:
        print("yes")
        raise SystemExit(0)
print("no")
' "${CF_DNS_JSON}" "${_ip}")
        if [ "${_hit}" = "yes" ]; then
            _st="already"
        else
            cf_api_curl POST "https://api.cloudflare.com/client/v4/zones/${CFV_ZONE_ID}/dns_records" \
                "$(cf_dns_payload "${_fqdn}" "${_ip}")"
            _st="created"
        fi
    elif [ "${_n}" -gt 1 ]; then
        if [ "${FORCE}" -ne 1 ]; then
            rm -f "${CF_DNS_JSON}"
            out_die_code dns_multi_record "Multiple A records for ${_fqdn}"
        fi
        cf_dns_collapse "${_ip}"
        _kid="${CF_KEEP_ID}"
        if [ -n "${_kid}" ]; then
            cf_api_curl PUT "https://api.cloudflare.com/client/v4/zones/${CFV_ZONE_ID}/dns_records/${_kid}" \
                "$(cf_dns_payload "${_fqdn}" "${_ip}")"
        else
            cf_api_curl POST "https://api.cloudflare.com/client/v4/zones/${CFV_ZONE_ID}/dns_records" \
                "$(cf_dns_payload "${_fqdn}" "${_ip}")"
        fi
        _st="collapsed"
    elif [ "${_n}" -eq 1 ]; then
        _cur=$(cf_dns_first content)
        _rid=$(cf_dns_first id)
        if [ "${_cur}" = "${_ip}" ]; then
            _st="already"
        else
            cf_api_curl PUT "https://api.cloudflare.com/client/v4/zones/${CFV_ZONE_ID}/dns_records/${_rid}" \
                "$(cf_dns_payload "${_fqdn}" "${_ip}")"
            _st="updated"
        fi
    else
        cf_api_curl POST "https://api.cloudflare.com/client/v4/zones/${CFV_ZONE_ID}/dns_records" \
            "$(cf_dns_payload "${_fqdn}" "${_ip}")"
        _st="created"
    fi
    rm -f "${CF_DNS_JSON}" "${CF_API_BODY:-}"
    if [ "${JSON}" -eq 1 ]; then
        out_json "success" "A record ${_st}" \
            "command" "add" "fqdn" "${_fqdn}" "ip" "${_ip}" "status" "${_st}" \
            "mode" "${CF_SEL_MODE}" "ipv4_count" "${_n}" \
            "@ttl" "${CF_OPT_TTL:-300}" "@proxied" "${CF_OPT_PROXIED:-false}"
    else
        out_success "${_fqdn} -> ${_ip} (${_st})"
    fi
}

cf_dns_update() {
    cf_dns_ensure_ready
    cf_select_label
    _lab="${CF_SEL_LABEL}"
    _fqdn=$(cf_derive_fqdn "${_lab}" "${CFV_DOMAIN}")
    cf_ip_lookup
    _ip="${CF_PUBLIC_IP}"
    cf_zone_check
    cf_dns_list "${_fqdn}"
    _n="${CF_DNS_COUNT}"
    : "${CF_SEL_MODE:=non-round-robin}"
    if [ "${_n}" -eq 0 ]; then
        rm -f "${CF_DNS_JSON}"
        out_die_code dns_missing "No A record for ${_fqdn}"
    fi
    if [ "${CF_SEL_MODE}" = "round-robin" ] && [ "${_n}" -gt 1 ]; then
        if [ -z "${CF_OPT_FROM:-}" ]; then
            rm -f "${CF_DNS_JSON}"
            out_die_code dns_target_required "Round-robin update needs --from OLD"
        fi
        _rid=$(python3 -c '
import json,sys
path, old = sys.argv[1], sys.argv[2]
with open(path, encoding="utf-8") as fh:
    data=json.load(fh)
for rec in data.get("result") or []:
    if rec.get("content")==old:
        print(rec.get("id",""))
        raise SystemExit(0)
raise SystemExit(2)
' "${CF_DNS_JSON}" "${CF_OPT_FROM}") || {
            rm -f "${CF_DNS_JSON}"
            out_die_code dns_missing "No A record with --from ${CF_OPT_FROM}"
        }
        cf_api_curl PUT "https://api.cloudflare.com/client/v4/zones/${CFV_ZONE_ID}/dns_records/${_rid}" \
            "$(cf_dns_payload "${_fqdn}" "${_ip}")"
    elif [ "${_n}" -gt 1 ]; then
        if [ "${FORCE}" -ne 1 ]; then
            rm -f "${CF_DNS_JSON}"
            out_die_code dns_multi_record "Multiple A records for ${_fqdn}"
        fi
        cf_dns_collapse "${_ip}"
        _kid="${CF_KEEP_ID}"
        cf_api_curl PUT "https://api.cloudflare.com/client/v4/zones/${CFV_ZONE_ID}/dns_records/${_kid}" \
            "$(cf_dns_payload "${_fqdn}" "${_ip}")"
    else
        _rid=$(cf_dns_first id)
        cf_api_curl PUT "https://api.cloudflare.com/client/v4/zones/${CFV_ZONE_ID}/dns_records/${_rid}" \
            "$(cf_dns_payload "${_fqdn}" "${_ip}")"
    fi
    rm -f "${CF_DNS_JSON}" "${CF_API_BODY:-}"
    if [ "${JSON}" -eq 1 ]; then
        out_json "success" "A record updated" "command" "update" "fqdn" "${_fqdn}" "ip" "${_ip}"
    else
        out_success "Updated ${_fqdn} -> ${_ip}"
    fi
}

