# =============================================================================
# app_about() - Diagnostics (local-only; no channel one-liner)
# =============================================================================
#
# ALIGNMENT:
# - requirement-shell-cli-interface.md
# - requirement-domain-folder-backup.md (about domain fields)
# - requirement-shell-cli-storage.md
#
# Last reviewed: 2026-08-03
# =============================================================================
app_about() {
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${APP_NAME:=folder-backup}"
    : "${VERSION:=1.2.1}"
    : "${REPO_USER:=cloudgen}"
    : "${REPO_NAME:=folder-backup}"
    : "${SCRIPT_URL:=}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${HOME:=/tmp}"
    : "${USER_BIN:=${HOME}/.local/bin}"
    : "${USERNAME:=unknown}"
    : "${RESTORE_HOST_DEFAULT:=hard-disk}"
    : "${PROJECTS_ROOT:=}"
    : "${RAM_ROOT:=/dev/shm}"
    : "${XDG_CACHE_HOME:=${HOME}/.cache}"
    : "${BACKUP_ROOT:=/var/backup}"
    : "${BACKUP_NOTATION:=folder-backup}"

    if [ -z "${EFFECTIVE_STORAGE_DIR:-}" ]; then
        EFFECTIVE_STORAGE_DIR=$(util_resolve_storage)
    fi
    : "${STORAGE_DIR:=${XDG_CACHE_HOME}/${APP_NAME}-${USERNAME}}"

    _installed="false"
    inst_is_installed && _installed="true"

    _global_ver="not found"
    if [ -x "${GLOBAL_BIN}/${APP_NAME}" ]; then
        _global_ver=$(grep '^VERSION="' "${GLOBAL_BIN}/${APP_NAME}" 2>/dev/null | cut -d'"' -f2 || echo "unknown")
    fi
    _local_ver="not found"
    if [ -x "${USER_BIN}/${APP_NAME}" ]; then
        _local_ver=$(grep '^VERSION="' "${USER_BIN}/${APP_NAME}" 2>/dev/null | cut -d'"' -f2 || echo "unknown")
    fi
    _shell=$(util_get_current_shell)
    _user=$(id -un 2>/dev/null || echo "unknown")
    _interactive="false"
    [ -t 1 ] && _interactive="true"

    # Best-effort sudo deposit probe
    _sudo_deposit="unknown"
    if [ "$(id -u 2>/dev/null || echo 1)" -eq 0 ]; then
        _sudo_deposit="root"
    elif command -v sudo >/dev/null 2>&1; then
        if sudo -n true 2>/dev/null; then
            _sudo_deposit="sudo_n_ok"
        else
            _sudo_deposit="sudo_needs_auth_or_denied"
        fi
    else
        _sudo_deposit="no_sudo"
    fi

    if [ "${JSON}" -eq 1 ]; then
        out_json "about" "" \
            "app" "${APP_NAME}" \
            "version" "${VERSION}" \
            "repo_user" "${REPO_USER}" \
            "repo_name" "${REPO_NAME}" \
            "repository" "${REPO_USER}/${REPO_NAME}" \
            "script_url" "${SCRIPT_URL}" \
            "installed" "${_installed}" \
            "global_version" "${_global_ver}" \
            "local_version" "${_local_ver}" \
            "shell" "${_shell}" \
            "interactive" "${_interactive}" \
            "user" "${_user}" \
            "effective_storage" "${EFFECTIVE_STORAGE_DIR}" \
            "storage_dir" "${STORAGE_DIR}" \
            "backup_root" "${BACKUP_ROOT}" \
            "backup_notation" "${BACKUP_NOTATION}" \
            "deposit_dir" "${BACKUP_ROOT}/${BACKUP_NOTATION}" \
            "sudo_deposit" "${_sudo_deposit}" \
            "sudoers_trust_tier" "$(fb_sudoers_trust_tier)" \
            "restore_host_default" "${RESTORE_HOST_DEFAULT}" \
            "projects_root" "$(util_resolve_projects_root 2>/dev/null || echo "")" \
            "ram_root" "${RAM_ROOT}"
        return 0
    fi

    [ "${QUIET}" -eq 1 ] && return 0

    out_info "=== ${APP_NAME} ${VERSION} - About / Diagnostics ==="
    out_empty_line
    if [ "${_installed}" = "true" ]; then
        out_success "${APP_NAME} is properly installed."
    else
        out_warn "${APP_NAME} is NOT installed in a managed bin path."
        out_info "   Recommended: ${APP_NAME} install   (local copy → ${USER_BIN}/${APP_NAME})"
    fi
    out_empty_line
    out_info "Global install  (${GLOBAL_BIN}/${APP_NAME}):   ${_global_ver}"
    out_info "Local install   (${USER_BIN}/${APP_NAME}):    ${_local_ver}"
    _tier=$(fb_sudoers_trust_tier)
    out_info "Sudoers trust tier: ${_tier}  (production requires global; local-only = test mode)"
    out_empty_line
    out_info "Repository:        ${REPO_USER}/${REPO_NAME}"
    if [ -n "${SCRIPT_URL}" ]; then
        out_info "Install channel:   ${SCRIPT_URL}"
    else
        out_info "Install channel:   (empty — local install only)"
    fi
    out_empty_line
    out_info "Current user:      ${_user}"
    if [ "$(id -u)" -eq 0 ]; then
        out_success "Execution context: root"
    else
        out_info "Execution context: normal user (Type 0 + narrow Type 1 deposit)"
    fi
    out_empty_line
    out_info "Current shell:     ${_shell}"
    if [ -t 1 ]; then
        out_info "TTY / Interactive: yes"
    else
        out_info "TTY / Interactive: no"
    fi
    out_empty_line
    out_info "Storage (effective): ${EFFECTIVE_STORAGE_DIR}"
    out_info "Storage (fallback):  ${STORAGE_DIR}"
    out_empty_line
    out_info "Backup root:       ${BACKUP_ROOT}"
    out_info "Backup notation:   ${BACKUP_NOTATION}"
    out_info "Deposit directory: ${BACKUP_ROOT}/${BACKUP_NOTATION}"
    out_info "Sudo deposit:      ${_sudo_deposit}"
    _proot=$(util_resolve_projects_root 2>/dev/null || echo "")
    out_info "Restore default host: ${RESTORE_HOST_DEFAULT} (reverse of ram-drive-first)"
    out_info "Projects root (hard-disk): ${_proot:-unset — set PROJECTS_ROOT}"
    out_info "RAM root:          ${RAM_ROOT}"
    out_empty_line
    out_info "Useful commands:"
    out_info "   ${APP_NAME} help            → Full usage"
    out_info "   ${APP_NAME} install         → Local install to ~/.local/bin"
    out_info "   ${APP_NAME} print-sudoers   → Sudoers fragment for admin"
    out_info "   ${APP_NAME} backup <dir>    → Archive + deposit"
    out_info "   ${APP_NAME} restore <name>  → Restore archive (default dest: hard-disk)"
    out_info "   ${APP_NAME} --json          → Machine-readable output"
}

# =============================================================================
